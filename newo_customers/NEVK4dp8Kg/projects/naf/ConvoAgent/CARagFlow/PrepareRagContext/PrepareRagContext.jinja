{% set general_manager_agent_persona = GetAgent(idn="GeneralManagerAgent").persona_id %}
{% set user_id = GetUser().id|string %}

{% set rag_context_topics = SearchFuzzyAkb(
    query="",
    searchFields=["name"],
    numberTopics=700,
    scoreThreshold=0,
    filterByPersonaIds=[general_manager_agent_persona],
    labels=["rag_context"]
) %}

{% if not rag_context_topics %}
    {{SetPersonaAttribute(field="rag", value="", id=user_id)}}
    {{Return(val="")}}
{% endif %}

{% set rag_context_topics = rag_context_topics | sort(attribute='updatedAt', reverse=True) %}

{# Build prompt blocks via mutation to avoid per-iteration string reassignments in logs. #}
{% set rag_context_article_blocks = [] %}
{# Keep only the newest topic per source after sorting to reduce prompt size and preserve recency. #}
{% set topics_by_source = {} %}
{% for topic in rag_context_topics %}
    {% if topic.source not in topics_by_source %}
        {{ topics_by_source.update({topic.source: topic}) }}
        {{ rag_context_article_blocks.append(
            "article_title: " ~ topic.topic ~ "\n"
            ~ "article_facts: [" ~ (topic.facts | join(", ")) ~ "]\n"
            ~ "article_last_updated: " ~ (topic.updatedAt | string) ~ "\n"
            ~ "article_id: " ~ topic.source
        ) }}
    {% endif %}
{% endfor %}
{% set rag_context_topics_string = rag_context_article_blocks | join("\n\n---\n\n") %}

{% set prompt %}You are the search assistant.

**Use:**
- <ConversationHistory>
- <KnowledgeBaseArticles> (formatted per <KnowledgeBaseArticleFormat>)
- <ConversationMeta> (optional context)

**Task:**
Select the closest available articles from <KnowledgeBaseArticles> for the latest meaningful conversation topic.

Always choose the single best available article as `article_id_1`.
Then add up to two more distinct supporting articles if they are also useful.

**CRITICAL RULES:**
1. Determine the current topic from the latest meaningful messages in <ConversationHistory>. Use both user and agent messages. If the latest message is vague, resolve it using nearby messages.
2. `article_id_1` must be the closest available article from <KnowledgeBaseArticles>, even if it is broad or only indirectly related. Use `article_last_updated` only to break ties between articles about the same topic.
3. Use "none" only for `article_id_2` and `article_id_3` when no additional useful articles remain.

<ConversationMeta>
{{GetPersonaAttribute(id=user_id, field="conversation_meta")}}
</ConversationMeta>

<ConversationHistory>
{{memory_utils.get_memory(count=20, user_id=user_id)}}
</ConversationHistory>

<KnowledgeBaseArticleFormat>
article_title: `article_title`
article_facts: [`article_facts`]
article_last_updated: `article_last_updated`
article_id: `article_id`
</KnowledgeBaseArticleFormat>

<KnowledgeBaseArticles>
{{rag_context_topics_string}}
</KnowledgeBaseArticles>
{% endset %}

{% set schema = json.loads(prepare_rag_context_schema()) %}

{% set search_result_str = structured_generation(prompt=prompt, schema=schema) %}

{% set search_result = json.loads(search_result_str).get("search_result", {}) %}
{# Use explicit schema keys instead of relying on object value ordering from the runtime. #}
{% set search_results = [
    search_result.get("article_id_1", "none"),
    search_result.get("article_id_2", "none"),
    search_result.get("article_id_3", "none")
] %}
{# Resolve selected topics from the already-fetched AKB set instead of querying AKB again. #}
{% set rag_article_blocks = [] %}
{% set used_indexes = [] %}
{% for index in search_results %}
    {% if (index != "none") and (index in topics_by_source) and (not index in used_indexes) %}
        {{ used_indexes.append(index) }}
        {{ rag_article_blocks.append(topics_by_source[index].topic ~ "\n" ~ topics_by_source[index].summary) }}
    {% endif %}
{% endfor %}
{% set rag = rag_article_blocks | join("\n\n---\n\n") %}

{{SetPersonaAttribute(field="rag", value=rag, id=user_id)}}
