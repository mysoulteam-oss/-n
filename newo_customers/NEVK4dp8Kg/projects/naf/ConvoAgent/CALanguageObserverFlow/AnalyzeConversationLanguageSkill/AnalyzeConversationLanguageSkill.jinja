{% if GetCustomerAttribute(field="project_attributes_private_feature_flag_current_conversation_language") != "True" %}
    {{Return()}}
{% endif %}

{% set act_arguments = GetTriggeredAct().arguments %}
{% set user_id = GetUser().id | string %}
{% set latest_user_message = act_arguments.latestUserMessage %}
{% set conversation_channel = act_arguments.conversationChannel %}

{% if not latest_user_message.strip() %}
    {{Return()}}
{% endif %}

{{observe_current_conversation_language(
    user_id=user_id,
    user_utterance=latest_user_message,
    conversation_channel=conversation_channel,
    conversation_memory=act_arguments.memoryWithoutLatestAgentAnswer
)}}
