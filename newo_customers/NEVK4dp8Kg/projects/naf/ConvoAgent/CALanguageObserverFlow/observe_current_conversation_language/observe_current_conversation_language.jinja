{% set user_id = user_id or GetUser().id | string %}
{% if GetCustomerAttribute(field="project_attributes_private_feature_flag_current_conversation_language") != "True" %}
    {{Return(val=GetPersonaAttribute(id=user_id, field="current_conversation_language"))}}
{% endif %}

{% set user_utterance = (user_utterance or "").strip() %}
{% set conversation_memory = (conversation_memory or "").strip() %}
{% set conversation_channel = (conversation_channel or "chat").strip() %}

{% if not user_utterance %}
    {{Return(val=GetPersonaAttribute(id=user_id, field="current_conversation_language"))}}
{% endif %}

{% set current_language = persona_utils.get_current_conversation_language(user_id=user_id).strip() %}
{% set language_status = GetPersonaAttribute(id=user_id, field="current_conversation_language_status").strip() %}
{% if not language_status %}
    {% set language_status = "default_primary" %}
{% endif %}
{% set turns_since_observer_text = GetPersonaAttribute(id=user_id, field="current_conversation_language_turns_since_observer").strip() %}
{% set turns_since_observer = (turns_since_observer_text | int) if turns_since_observer_text else 0 %}
{% set utterance_words = user_utterance.split() %}
{% set word_count = utterance_words | length %}
{% set char_count = user_utterance | length %}
{% set turns_since_observer = turns_since_observer + 1 %}
{{SetPersonaAttribute(id=user_id, field="current_conversation_language_turns_since_observer", value=turns_since_observer | string)}}

{% set should_run_observer = True %}
{% if conversation_channel == "chat" %}
    {% set should_run_observer = False %}
    {% if word_count < 4 or char_count < 16 %}
        {% set should_run_observer = False %}
    {% elif language_status == "confirmed" %}
        {% if word_count >= 12 and turns_since_observer >= 4 %}
            {% set should_run_observer = True %}
        {% endif %}
    {% else %}
        {% if word_count >= 10 or turns_since_observer >= 3 %}
            {% set should_run_observer = True %}
        {% endif %}
    {% endif %}
{% else %}
    {% if word_count < 3 or char_count < 12 %}
        {% set should_run_observer = False %}
    {% elif language_status == "confirmed" and word_count < 5 %}
        {% set should_run_observer = False %}
    {% endif %}
{% endif %}

{% if not should_run_observer %}
    {% set gate_audit = {
        "skipped": True,
        "reason": "language_observer_gate",
        "conversation_channel": conversation_channel,
        "language_status": language_status,
        "turns_since_observer": turns_since_observer,
        "word_count": word_count,
        "char_count": char_count,
        "previous_language": current_language
    } %}
    {{SetPersonaAttribute(id=user_id, field="current_conversation_language_observer", value=json.dumps(gate_audit, ensure_ascii=False, indent=2))}}
    {{Return(val=current_language)}}
{% endif %}

{{SetPersonaAttribute(id=user_id, field="current_conversation_language_turns_since_observer", value="0")}}
{% set primary_language = GetCustomerAttribute(field="project_representative_agent_primary_language").strip() %}

{% set secondary_languages_list = GetCustomerAttribute(field="project_representative_agent_secondary_languages") %}
{% if secondary_languages_list.strip() and secondary_languages_list != "[]" %}
    {% set secondary_languages = json.loads(secondary_languages_list) %}
{% else %}
    {% set secondary_languages = [] %}
{% endif %}

{% set restricted_languages_list = GetCustomerAttribute(field="project_business_language_restricted_list") %}
{% if restricted_languages_list.strip() and restricted_languages_list != "[]" %}
    {% set restricted_languages = json.loads(restricted_languages_list) %}
{% else %}
    {% set restricted_languages = [] %}
{% endif %}

{% set multilingual_enabled = GetCustomerAttribute(field="project_representative_agent_multilingual") == "True" %}
{% set schema = {
  "type": "object",
  "properties": {
    "detected_language": {
      "type": "string",
      "description": "Best language name for the latest user utterance, or an empty string if unknown."
    },
    "confidence": {
      "type": "number",
      "description": "A conservative confidence score from 0.0 to 1.0."
    },
    "language_type": {
      "type": "string",
      "enum": ["primary", "secondary", "outside_primary_secondary", "unknown"],
      "description": "Classification of detected_language relative to the configured primary and secondary languages."
    },
    "explicit_switch_request": {
      "type": "boolean",
      "description": "True only when the user clearly asks to speak or continue in a specific language."
    },
    "utterance_reliable": {
      "type": "boolean",
      "description": "False for broken transcripts, unrelated garble, too-short ambiguous text, or low-quality STT-like output."
    },
    "should_switch_language": {
      "type": "boolean",
      "description": "True only if current_conversation_language should change now."
    },
    "reason": {
      "type": "string",
      "description": "Brief explanation of the decision."
    }
  },
  "required": [
    "detected_language",
    "confidence",
    "language_type",
    "explicit_switch_request",
    "utterance_reliable",
    "should_switch_language",
    "reason"
  ]
} %}

{% system %}
You are Language Observer for ConvoAgent. Your job is to decide whether the runtime
`current_conversation_language` should change after the latest USER utterance.

Be conservative. Wrongly switching away from the primary language is worse than temporarily staying
in the current language.

Use the latest user utterance as the primary signal. Do NOT use the language of the agent's previous
answer as independent evidence; that creates a feedback loop. Conversation history may be used only
to understand whether the user made an explicit language-switch request or whether the utterance is
semantically plausible in context.

Configuration:
- Primary language: {{primary_language}}
- Secondary languages: {{json.dumps(secondary_languages, ensure_ascii=False, indent=2)}}
- Multilingual mode enabled: {{multilingual_enabled | string}}
- Restricted languages: {{json.dumps(restricted_languages, ensure_ascii=False, indent=2)}}
- Current conversation language: {{current_language}}

Allowed switching rules:
- Switching to the primary language has the lowest threshold.
- Switching to a secondary language needs higher confidence than primary.
- Switching to a language outside primary/secondary is allowed only when multilingual mode is true,
  and requires very high confidence or a clear explicit language-switch request.
- If multilingual mode is false, never switch to a language outside primary/secondary.
- Never switch to a restricted language.
- Short ambiguous utterances like "agent", "yes", "no", "hello", "allo", names, or fragments are
  not enough to switch languages.
- Broken, unrelated, or low-quality transcripts must keep the current language unchanged.

Strong signal:
- If the user clearly asks to speak or continue in a specific allowed language, set
  explicit_switch_request=true and should_switch_language=true unless the transcript is broken.

Weak signal:
- Without an explicit request, require a reliable utterance with enough words and semantic fit.
- Multiple recent user turns in the same language can increase confidence, but do not count agent
  language as evidence.

Return only JSON matching the schema.

<LatestUserUtterance>
{{user_utterance}}
</LatestUserUtterance>

<RecentConversationHistory>
{{conversation_memory}}
</RecentConversationHistory>
{% end %}

{% set observer_result = json.loads(Gen(
    jsonSchema=json.dumps(schema, ensure_ascii=False, indent=2),
    validateSchema=True,
    temperature=0,
    topP=0,
    skipFilter=True,
    thinkingBudget=256
)) %}

{% set detected_language = (observer_result.get("detected_language", "") or "").strip() %}
{% set language_type = observer_result.get("language_type", "unknown") %}
{% set confidence = observer_result.get("confidence", 0) %}
{% set explicit_switch_request = observer_result.get("explicit_switch_request", False) %}
{% set utterance_reliable = observer_result.get("utterance_reliable", False) %}
{% set should_switch_language = observer_result.get("should_switch_language", False) %}

{% set language_is_restricted = detected_language in restricted_languages %}
{% set language_is_primary = detected_language == primary_language %}
{% set language_is_secondary = detected_language in secondary_languages %}
{% set language_is_allowed = language_is_primary or language_is_secondary or (multilingual_enabled and not language_is_restricted) %}

{% if (not detected_language) or language_is_restricted or (not language_is_allowed) %}
    {% set should_switch_language = False %}
{% endif %}
{% if not utterance_reliable %}
    {% set should_switch_language = False %}
{% endif %}
{% if should_switch_language and (not explicit_switch_request) %}
    {% if language_is_primary and confidence < 0.55 %}
        {% set should_switch_language = False %}
    {% elif language_is_secondary and confidence < 0.75 %}
        {% set should_switch_language = False %}
    {% elif (not language_is_primary) and (not language_is_secondary) and confidence < 0.92 %}
        {% set should_switch_language = False %}
    {% endif %}
{% endif %}

{% set observer_audit = {
    "skipped": False,
    "detected_language": detected_language,
    "confidence": confidence,
    "language_type": language_type,
    "explicit_switch_request": explicit_switch_request,
    "utterance_reliable": utterance_reliable,
    "should_switch_language": should_switch_language,
    "reason": observer_result.get("reason", ""),
    "server_allowed": language_is_allowed,
    "server_restricted": language_is_restricted,
    "previous_language": current_language
} %}
{{SetPersonaAttribute(id=user_id, field="current_conversation_language_observer", value=json.dumps(observer_audit, ensure_ascii=False, indent=2))}}

{% if should_switch_language %}
    {{SetPersonaAttribute(id=user_id, field="current_conversation_language", value=detected_language)}}
    {{SetPersonaAttribute(id=user_id, field="current_conversation_language_source", value="language_observer")}}
    {{SetPersonaAttribute(id=user_id, field="current_conversation_language_status", value="confirmed")}}
    {{Return(val=detected_language)}}
{% endif %}

{% if utterance_reliable and detected_language == current_language and confidence >= 0.75 %}
    {{SetPersonaAttribute(id=user_id, field="current_conversation_language_status", value="confirmed")}}
{% elif utterance_reliable and detected_language and language_is_allowed and (not language_is_restricted) %}
    {{SetPersonaAttribute(id=user_id, field="current_conversation_language_status", value="tentative")}}
{% endif %}

{{Return(val=current_language)}}
