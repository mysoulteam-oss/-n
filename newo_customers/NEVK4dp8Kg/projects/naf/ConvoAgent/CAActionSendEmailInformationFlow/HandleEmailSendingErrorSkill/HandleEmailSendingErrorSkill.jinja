{% set user_id = GetUser().id | string %}

{% set actor_id = GetPersonaAttribute(id=user_id, field="last_convo_actor_id") %}

{# Exit if the conversation is no longer active #}
{% if not actor_id.strip() %}
  {{Return()}}
{% endif %}

{# IMPORTANT: email_actor_ prefix is the sole discriminator for email channel actors.
   integrationIdn="system" is shared by voice, chat, and other channels.
   If a new email integration is added that doesn't use this prefix, update this guard. #}
{# Exit if current conversation channel is email (prevent recursion) #}
{% if (GetActor(id=actor_id).externalId | string).startswith("email_actor_") %}
  {{Return()}}
{% endif %}

{# Clear sent message history so retry is not blocked as duplicate #}
{{SetPersonaAttribute(id=user_id, field="email_already_sent_information", value="")}}

{#  Exit in case of Agent already mentioned issue during conversation #}
{% set agent_mentioned_email_delivery_failure = GetPersonaAttribute(id=user_id, field="agent_mentioned_email_delivery_failure") %}
{% if agent_mentioned_email_delivery_failure == "True" %}
  {{Return()}}
{% endif %}

{% set arguments = GetTriggeredAct().arguments %}
{% set email_error_code = arguments.code | string %}
{% set email_error_reason = arguments.reason %}

{% if not email_error_code %}
  {% set email_error_code = "unknown" %}
{% endif %}
{% if not email_error_reason %}
  {% set email_error_reason = "unspecified issue" %}
{% endif %}

{% set email_error_log = "The email delivery failed due to an unknown issue." %}

{# OPT_OUT: User has previously opted out of receiving emails #}
{% if email_error_code == "OPT_OUT" %}
  {% set email_error_log = " The user has previously opted out of receiving emails. Inform the user that the email could not be sent because they opted out, and ask if they would like to re-subscribe to receive emails." %}
{% endif %}

{% if email_error_code == "OPT_OUT" %}
  {% set full_message = email_error_log %}
{% else %}
  {% set full_message = "Apologize to the user and say that the email was not delivered." + email_error_log %}
{% endif %}

{{SendSystemEvent(
  eventIdn="urgent_message",
  connectorIdn="system",
  baseInstruction=full_message,
  callAnalyzeConversationSkill="False",
  callManageTaskSkill="False",
  uninterruptible="True"
)}}

{{SetPersonaAttribute(id=user_id, field="agent_mentioned_email_delivery_failure", value="True")}}
