{% set schema = {
  "type": "object",
  "properties": {
    "established_conversation_language": {
      "type": "string",
      "description": "The dominant language of the user's intelligible turns across the whole conversation, judged from their longest and clearest utterances. Ignore single-word noise tokens, garbled transcriptions, and ASR artifacts. If the user spoke two languages roughly equally and intentionally, set to 'mixed'. This field is the baseline against which language-fidelity failures (`agent_misidentified_clear_phrase_language`, `agent_switched_on_garbled_turn`, `agent_spoke_code_phrase_in_wrong_language`) are judged."
    },
    "agent_contradicting_phrases": {
      "type": "boolean",
      "description": "Set to `true` if the agent produced contradicting phrases or statements within the same conversation."
    },
    "agent_contradicting_phrases_examples": {
      "type": "array",
      "description": "Examples of contradicting phrases or statements produced by the agent. Max 5. Return an empty array if no required fields were skipped.",
      "items": {
        "type": "string"
      }
    },
    "agent_declines_capability": {
      "type": "boolean",
      "description": "Set to `true` if the agent says it cannot perform a specific requested action (e.g. cannot change data, cannot transfer, cannot access information)."
    },
    "agent_declines_capability_examples": {
      "type": "array",
      "description": "Examples of agent phrases stating that it cannot perform a specific requested action. Max 5. Return an empty array if no required fields were skipped.",
      "items": {
        "type": "string"
      }
    },
    "agent_not_replying": {
      "type": "boolean",
      "description": "Set to `true` if the agent goes silent or fails to respond. Indicators: consecutive user messages without agent reply, user asking 'hello?'/'are you there?', user repeating themselves, or explicit silence/pause markers in transcript."
    },
    "agent_not_replying_examples": {
      "type": "array",
      "description": "Examples of user messages and the lack of appropriate agent replies. Max 5. Return an empty array if no required fields were skipped.",
      "items": {
        "type": "string"
      }
    },
    "agent_looping_detected": {
      "type": "boolean",
      "description": "Set to `true` only if agent repeats the same question or response 3+ times consecutively without progressing. Minor greeting repetitions do not qualify."
    },
    "agent_looping_examples": {
      "type": "array",
      "description": "Examples of agent phrases or turns that illustrate looping behavior. Max 5. Return an empty array if no required fields were skipped.",
      "items": {
        "type": "string"
      }
    },
    "agent_asks_already_answered_questions_count": {
      "type": "integer",
      "description": "Number of questions from the agent that request information the user has already clearly provided."
    },
    "agent_asks_already_answered_questions_examples": {
      "type": "array",
      "description": "Examples of agent questions that request information already provided by the user. Max 5. Return an empty array if no required fields were skipped.",
      "items": {
        "type": "string"
      }
    },
    "agent_reports_technical_issue": {
      "type": "boolean",
      "description": "Set to `true` ONLY if the AGENT tells the user about a technical problem (system error, service down, can't access data). Must be the AGENT speaking. Do NOT set true if the USER mentions an error or technical issue — that's user-reported, not agent-reported."
    },
    "agent_technical_issue_category": {
      "type": "string",
      "enum": ["sms", "email", "transfer call", "booking", "availability check", "other", "none"],
      "description": "Category of the technical issue reported by the agent, if any."
    },
    "language_switching_behavior": {
      "type": "boolean",
      "description": "Set to `true` ONLY if the user or agent deliberately switches to a different language to communicate. Must be intentional speech, not background noise, TV/radio audio, or common loanwords (café, pizza, etc.). Example: conversation starts in English, then user continues in Russian."
    },
    "agent_fails_to_switch_language": {
      "type": "boolean",
      "description": "Set to `true` if the agent does not switch language after the user has asked or clearly started speaking another language."
    },
    "languages_used": {
      "type": "array",
      "description": "List of languages that appear in the conversation (by user or agent), represented by language codes or names.",
      "items": {
        "type": "string"
      }
    },
    "agent_checks_users_presence": {
      "type": "boolean",
      "description": "Set to `true` if the agent asks whether the user is still there or responsive."
    },
    "agent_misidentified_clear_phrase_language": {
      "type": "boolean",
      "description": "Set to `true` if the user turn produced meaningful phrase in the established conversation language X (a complete sentence, question, or statement), and the agent replied next turn in a different language Y. Do NOT set `true` if the user explicitly requested switch to other language or themselves switched. DO NOT set `true` if agent re-ask user due to misunderstanding."
    },
    "agent_misidentified_clear_phrase_language_examples": {
      "type": "array",
      "description": "Each example must include: (a) the user's clear phrase and its actual language, (b) the agent's reply and the wrong language used. Max 5. Return an empty array if no required fields were skipped.",
      "items": {
        "type": "string"
      }
    },
    "agent_spoke_code_phrase_in_wrong_language": {
      "type": "boolean",
      "description": "Set to `true` if the agent delivered a scripted/canonical code-phrase verbatim in a language that does NOT match the established conversation language — in EITHER direction. Typical code-phrases include transfer scripts, booking submission scripts, SMS/email send scripts, and availability-check scripts."
    },
    "agent_spoke_code_phrase_in_wrong_language_examples": {
      "type": "array",
      "description": "Each example must include the code-phrase the agent spoke, the language it was rendered in, and the established conversation language it should have matched. Max 5. Return an empty array if no required fields were skipped.",
      "items": {
        "type": "string"
      }
    },
    "agent_switched_on_garbled_turn": {
      "type": "boolean",
      "description": "Set to `true` when a user turn reads like ASR noise — incoherent transcription, mixed scripts, transliteration that does not form coherent words, or nonsense syllables — and the agent's reply that follows is in a language different from the established conversation language. Use this field when the user's actual language matches the established conversation language but the transcript glitched. Use this INSTEAD OF `agent_misidentified_clear_phrase_language` whenever the trigger turn is incoherent."
    },
    "agent_switched_on_garbled_turn_examples": {
      "type": "array",
      "description": "Each example must include: (a) the garbled/misheard user turn as transcribed, (b) the established conversation language, (c) the wrong language the agent switched to. Max 5. Return an empty array if no required fields were skipped.",
      "items": {
        "type": "string"
      }
    }
  }
} %}

{% set prompt %}

You are a QA analyst. Your goal is to evaluate conversation between ConvoAgent and {{GetUser().name}} (enclosed in <Conversation>...</Conversation>). In this session {{session_short_description}}.

<Conversation>
{{transcript}}
</Conversation>

{% endset %}

{% set result_json = structured_generation(schema=schema, prompt=prompt.strip()) %}

{{Return(val=result_json)}}
