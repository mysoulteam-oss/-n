{# TODO: When we finally have scenarios as separate entities, we’ll be able to get the exact scenario and all procedures included in it to analyze the specific scenario the ConvoAgent was supposed to follow. For now, we are retrieving all scenarios, which makes the scope broader. #}
{% set industry = GetCustomerAttribute(field="project_business_industry") %}
{% set integration_idn = session_utils.session_get_initial_integration_idn() %}
{% set conversation_channel = session_utils.session_get_conversation_channel(integration_idn=integration_idn) %}
{% set working_hours_status_bool = GetPersonaAttribute(id=user_id, field="working_hours_status") %}

{% set last_session_date_time = GetPersonaAttribute(id=user_id, field="last_session_ended_datetime_utc") %}
{% set system_logs = memory_utils.get_memory(
    actors=[common_utils.get_footnote_actor_id(system="True")],
    user_id=user_id,
    count=300,
    from_date=last_session_date_time
) %}

{% set semaphore_analysis_result_json = json.loads(get_semaphore_analysis(
    scenarios=scenarios,
    logs=system_logs,
    main_scenario=main_scenario,
    session_short_description=session_short_description,
    working_hours_status_bool=working_hours_status_bool,
    transcript=transcript,
    conversation_channel=conversation_channel,
    intents=intents
)) %}

{% set semaphore_summary_result_json = json.loads(get_semaphore_summary(
    scenarios=scenarios,
    logs=system_logs,
    main_scenario=main_scenario,
    session_short_description=session_short_description,
    working_hours_status_bool=working_hours_status_bool,
    transcript=transcript,
    conversation_channel=conversation_channel,
    intents=intents
)) %}

{% set session = semaphore_analysis_result_json.session %}
{% set scenario = semaphore_analysis_result_json.scenario %}
{% set analysis = semaphore_analysis_result_json.analysis %}

{% set result_json = {} %}

{% set is_lead = define_lead(industry=industry, session=session, intent_name=intent_name) %}
{% set contact_details_present = check_user_contact_details_present(user_id=user_id) %}
{% set contact_details_present = True if contact_details_present == "True" else False %}

{{ result_json.update(
    {
        "sessionType": intent_name,
        "sessionName": intent_name.replace("[L]", "").replace("[T]", "").strip(),
        "isLead": is_lead,
        "isTest": semaphore_analysis_result_json.is_test,
        "isTodo": ("[T]" in intent_name) or analysis.user_relayed_message or analysis.agent_promised_third_party_help,
        "contactDetailsPresent": contact_details_present

    })}}

{# score the production schema; emit_reports=True sends the fallback reports as before #}
{% set production = json.loads(derive_assessment_result(
    scenario=scenario,
    analysis=analysis,
    is_lead=is_lead,
    is_test=semaphore_analysis_result_json.is_test,
    contact_details_present=contact_details_present,
    transcript=transcript,
    session_short_description=session_short_description,
    user_id=user_id,
    report_is_sent=report_is_sent,
    emit_reports=True
)) %}

{{result_json.update({
    "agentSuccessCode": production.agentSuccessCode,
    "aiResultSuccess": production.aiResultSuccess,
    "isOpportunity": production.isOpportunity,
    "agentSuccessFactor": production.agentSuccessFactor,
    "isReporting": production.isReporting
})}}

{# re-apply derived values used by the legacy formatter #}
{{analysis.update({"agent_saved": production.agentSaved})}}
{{semaphore_analysis_result_json.update({"is_reporting": production.isReporting})}}

{# -- actualResult -- #}
{{result_json.update({"actualResult": semaphore_format_skill(
        report=json.dumps(semaphore_summary_result_json.actual_result, ensure_ascii=False, indent=2),
        actual="True",
        analysis=json.dumps(semaphore_analysis_result_json, ensure_ascii=False, indent=2)
)})}}

{# -- expectedResult -- #}
{{result_json.update({"expectedResult": semaphore_format_skill(
        report=json.dumps(semaphore_summary_result_json.expected_result, ensure_ascii=False, indent=2),
        expected="True",
        analysis=json.dumps(semaphore_analysis_result_json, ensure_ascii=False, indent=2)
)})}}

{# Queue optional shadow scoring outside the production assessment worker. #}
{% if GetCustomerAttribute(field="project_attributes_setting_shadow_metrics_enabled") == "True" %}
    {{SendSystemEvent(
        eventIdn="calculate_shadow_assessment",
        connectorIdn="system",
        shadow_assessment_payload=json.dumps({
            "user_id": user_id,
            "scenarios": scenarios,
            "logs": system_logs,
            "main_scenario": main_scenario,
            "session_short_description": session_short_description,
            "working_hours_status_bool": working_hours_status_bool,
            "transcript": transcript,
            "conversation_channel": conversation_channel,
            "intents": intents,
            "is_lead": is_lead,
            "contact_details_present": contact_details_present,
            "report_is_sent": report_is_sent,
            "intent_name": intent_name,
            "is_opportunity_prod": result_json.isOpportunity,
            "agent_success_code_prod": result_json.agentSuccessCode
        }, ensure_ascii=False, indent=2)
    )}}
{% endif %}

{{Return(val=json.dumps(result_json, ensure_ascii=False, indent=2))}}
