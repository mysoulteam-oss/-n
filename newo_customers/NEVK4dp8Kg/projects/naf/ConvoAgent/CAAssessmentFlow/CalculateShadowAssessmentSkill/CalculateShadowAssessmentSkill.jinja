{% set shadow_assessment_payload = json.loads(GetTriggeredAct().arguments.shadow_assessment_payload) %}

{% set semaphore_v2 = json.loads(get_semaphore_analysis_v2(
    scenarios=shadow_assessment_payload.scenarios,
    logs=shadow_assessment_payload.logs,
    main_scenario=shadow_assessment_payload.main_scenario,
    session_short_description=shadow_assessment_payload.session_short_description,
    working_hours_status_bool=shadow_assessment_payload.working_hours_status_bool,
    transcript=shadow_assessment_payload.transcript,
    conversation_channel=shadow_assessment_payload.conversation_channel,
    intents=shadow_assessment_payload.intents
)) %}
{% set scenario_v2 = semaphore_v2.scenario %}
{% set analysis_v2 = semaphore_v2.analysis %}
{% set business_issues_v2 = analysis_v2.business_issues.strip().lower() or "n/a" %}
{% set mentioned_issues_v2 = analysis_v2.mentioned_issues.strip().lower() or "n/a" %}

{% set shadow = json.loads(derive_assessment_result(
    scenario=scenario_v2,
    analysis=analysis_v2,
    is_lead=shadow_assessment_payload.is_lead,
    is_test=semaphore_v2.is_test,
    contact_details_present=shadow_assessment_payload.contact_details_present,
    transcript=shadow_assessment_payload.transcript,
    session_short_description=shadow_assessment_payload.session_short_description,
    user_id=shadow_assessment_payload.user_id,
    report_is_sent=shadow_assessment_payload.report_is_sent,
    emit_reports=False
)) %}

{{SendSystemEvent(
    eventIdn="convoagent_shadow_metrics",
    connectorIdn="system",
    userActor=GetPersonaAttribute(id=shadow_assessment_payload.user_id, field="actorId"),
    externalActorId=GetPersonaAttribute(id=shadow_assessment_payload.user_id, field="externalActorId"),
    integrationIdn=GetPersonaAttribute(id=shadow_assessment_payload.user_id, field="integrationIdn"),
    connector=GetPersonaAttribute(id=shadow_assessment_payload.user_id, field="connectorIdn"),
    sessionType=shadow_assessment_payload.intent_name,
    shadowSchemaVersion="v9_pr2059",
    isLead=shadow_assessment_payload.is_lead,
    contactDetailsPresent=json.dumps(shadow_assessment_payload.contact_details_present, ensure_ascii=False, indent=2),
    isOpportunityProd=shadow_assessment_payload.is_opportunity_prod,
    isOpportunityV2=shadow.isOpportunity,
    agentSuccessCodeProd=shadow_assessment_payload.agent_success_code_prod,
    agentSuccessCodeV2=shadow.agentSuccessCode,
    userRefusedV2=json.dumps(analysis_v2.user_refused, ensure_ascii=False, indent=2),
    userRejectedV2=json.dumps(analysis_v2.user_rejected, ensure_ascii=False, indent=2),
    failCausedByUserV2=json.dumps(analysis_v2.fail_caused_by_user, ensure_ascii=False, indent=2),
    userRelayedMessageV2=json.dumps(analysis_v2.user_relayed_message, ensure_ascii=False, indent=2),
    agentSavedV2=json.dumps(shadow.agentSaved, ensure_ascii=False, indent=2),
    taskCompletedV2=json.dumps(scenario_v2.task_completed, ensure_ascii=False, indent=2),
    businessIssuesV2=business_issues_v2,
    mentionedIssuesV2=mentioned_issues_v2,
    isTestV2=json.dumps(semaphore_v2.is_test, ensure_ascii=False, indent=2)
)}}
