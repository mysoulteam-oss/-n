{# defining lead #}
{# agentSuccessCode (Yes-A(1) / Yes-B(2) / No(0)) #}
{# Yes-A == 1 --> MUST BE `scenario_task_completed` && `essential_steps_completed`#}
{# -- OR -- #}
{# Yes-B == 2--> MUST BE `agent_saved` or report_is_sent == True(if not send it) -- #}}
{# -- OR -- #}
{# -- No == 0 -- #}

{# Yes-A / Yes-B #}
{% if scenario.task_completed %}
    {% if (analysis.agent_promised_third_party_help or analysis.user_relayed_message) and report_is_sent == "False" %}
        {% if emit_reports %}
            {{SendSystemEvent(
                eventIdn="convoagent_send_fallback_email_report",
                connectorIdn="system",
                intentType="[T] Customer message",
                transcript=transcript
            )}}
        {% endif %}
        {% set report_is_sent = "True" %}
    {% endif %}
    {% if scenario.essential_steps_completed %}
        {% set agent_success_code = "1" %}
    {% else %}
        {% set agent_success_code = "2" %}
    {% endif %}
{% else %}
    {% if (analysis.fail_caused_by_user or analysis.user_rejected or analysis.user_refused) and report_is_sent == "False" %}
        {% if is_lead == "true" %}
            {% if contact_details_present %}
                {% if emit_reports %}
                    {{SendSystemEvent(
                        eventIdn="convoagent_send_fallback_email_report",
                        connectorIdn="system",
                        intentType="[T] Partial Lead",
                        transcript=transcript,
                        customEmailSection=generate_missing_lead_email(session_short_description=session_short_description, user_behavior_analysis=analysis.user_behavior_analysis),
                        customSmsSection=generate_missing_lead_sms(user_id=user_id, session_short_description=session_short_description, user_behavior_analysis=analysis.user_behavior_analysis)
                    )}}
                {% endif %}
                {% set report_is_sent = "True" %}
                {% set agent_success_code = "1" %}
            {% else %}
                {# TODO: Is it 1 or 2? #}
                {% set agent_success_code = "2" %}
            {% endif %}
        {% else %}
            {% set agent_success_code = "1" %}
        {% endif %}
    {% elif analysis.agent_saved or (report_is_sent == "True") %}
        {% set agent_success_code = "2" %}
    {# TODO: Check if this condition is necessary #}
    {% elif report_is_sent == "False" %}
        {% if is_lead == "true" %}
            {% if contact_details_present %}
                {% if emit_reports %}
                    {{SendSystemEvent(
                        eventIdn="convoagent_send_fallback_email_report",
                        connectorIdn="system",
                        intentType="[T] Partial Lead",
                        transcript=transcript,
                        customEmailSection=generate_missing_lead_email(session_short_description=session_short_description, user_behavior_analysis=analysis.user_behavior_analysis),
                        customSmsSection=generate_missing_lead_sms(user_id=user_id, session_short_description=session_short_description, user_behavior_analysis=analysis.user_behavior_analysis)
                    )}}
                {% endif %}
                {% set report_is_sent = "True" %}
                {% set agent_success_code = "2" %}
            {% else %}
                {% set agent_success_code = "0" %}
            {% endif %}
        {% else %}
            {% set agent_success_code = "0" %}
        {% endif %}
    {% else %}
        {% set agent_success_code = "1" %}
    {% endif %}
{% endif %}


{% if (analysis.user_relayed_message or analysis.agent_promised_third_party_help) and (report_is_sent == "False") %}
    {% if emit_reports %}
        {{SendSystemEvent(
            eventIdn="convoagent_send_fallback_email_report",
            connectorIdn="system",
            intentType="[T] Customer message",
            transcript=transcript
        )}}
    {% endif %}
    {% set report_is_sent = "True" %}
{% endif %}

{# If report was sent, it means agent saved this session #}
{% if report_is_sent == "True" %}
    {{analysis.update({"agent_saved": True})}}
{% endif %}
{% set agent_saved = analysis.agent_saved %}

{% if agent_success_code in ("1", "2") %}
    {% set is_success = "true" %}
{% else %}
    {% set is_success = "false" %}
{% endif %}

{% set is_opportunity = "false" %}
{% set business_issues_normalized = analysis.business_issues.strip().lower() %}
{% set has_business_issues = business_issues_normalized not in ("", "n/a") %}

{# Opportunities include leads unless any of these exclusions apply: #}
{# 1) The conversation was detected as a test. #}
{# 2) No contact details are available for follow-up. #}
{# 3) The user refused to buy. #}
{# 4) A business issue prevented task completion and the agent did not save the session. #}
{% if is_lead == "true" %}
    {% set is_opportunity = "true" %}
    {% if is_test
       or (not contact_details_present)
       or analysis.user_refused
       or (has_business_issues and (not scenario.task_completed) and (not analysis.agent_saved)) %}
        {% set is_opportunity = "false" %}
    {% endif %}
{% endif %}

{% set success_factor = "1" if agent_success_code != "0" else "0" %}
{% set technical_issues_normalized = analysis.technical_issues.strip().lower() %}
{% set has_technical_issues = technical_issues_normalized not in ("", "n/a") %}

{% set is_reporting = (
    (
        (not scenario.task_completed)
        and (not analysis.agent_saved)
        and (not analysis.fail_caused_by_user)
    )
    or has_technical_issues
) %}

{{Return(val=json.dumps({
    "agentSuccessCode": agent_success_code,
    "aiResultSuccess": is_success,
    "isOpportunity": is_opportunity,
    "agentSuccessFactor": success_factor,
    "isReporting": is_reporting,
    "agentSaved": agent_saved,
    "reportIsSent": report_is_sent
}, ensure_ascii=False, indent=2))}}
