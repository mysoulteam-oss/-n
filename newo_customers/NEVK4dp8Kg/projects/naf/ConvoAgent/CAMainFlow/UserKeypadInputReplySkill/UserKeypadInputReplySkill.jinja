{% set user_id = GetUser().id | string %}
{% set arguments = GetTriggeredAct().arguments %}
{% set actor_id = session_get_and_set_last_convo_actor_id(user_id=user_id) %}
{% set integration_idn = session_get_current_integration_idn(user_id=user_id, set_persona_attribute="True") %}

{% set dtmf_input = arguments.digits %}

{% if dtmf_input and dtmf_input.strip() %}
    {{CreateMessageAct(
        text=("User's dial pad input: " ~ dtmf_input),
        from="user",
        userActorId=actor_id
    )}}
{% endif %}

{% set voice_mode = GetCustomerAttribute(field="project_attributes_setting_voice_integration_service_voice_mode") %}
{% set v2v_enabled = "True" if voice_mode in ["voice-to-voice", "speech-to-speech"] else "False" %}

{% set keypad_input_instructions %}
You've just received the dial pad (DTMF) input from the user:
"{{ dtmf_input }}".

Tell the user that you have received their input. Handle it according to your instructions.
{% endset %}

{{SendSystemEvent(
  eventIdn="convoagent_enable_follow_up",
  connectorIdn="system"
)}}

{% if integration_idn == "newo_voice" %}
    {% if v2v_enabled == "True" %}
        {% if v2v_get_current_provider(user_id=user_id) != "genai" %}
            {% set key_directives = '<CurrentTaskAnalysis alt="analysis of the current task, which may be slightly outdated" role="instructions">' ~ keypad_input_instructions ~ "</CurrentTaskAnalysis>" %}
            {{ v2v_add_context(turn=key_directives, user_id=user_id) }}
        {% endif %}
        {{ v2v_send_command(command=keypad_input_instructions, user_id=user_id) }}
        {{ Return() }}
    {% endif %}
{% endif %}
{{_userMessageFastReplySkill(
    base_instruction=keypad_input_instructions,
    call_analyze_conversation="True",
    user_id=user_id,
    integration_idn=integration_idn
)}}
