{{SendSystemEvent(eventIdn="build_operating_phrase", connectorIdn="system")}}
{{SendSystemEvent(eventIdn="prepare_injecting_data", connectorIdn="system", global="True")}}
{{SetState(name="user_reply_buffer", value=" ")}}
{{SetState(name="corrected_memory", value=" ")}}
{% set user_id = GetUser().id | string %}
{% set actor = actor or GetActor() %}

{{initialize_current_conversation_language(user_id=user_id)}}
{{SetPersonaAttribute(id=user_id, field="conversation_concluded", value="False")}}
{{SetPersonaAttribute(id=user_id, field="session_current_integration_idn", value=actor.integrationIdn | string)}}
{{SetPersonaAttribute(id=user_id, field="session_current_connector_idn", value=actor.connectorIdn | string)}}

{% if _utilsFeatureFlagIsActiveSkill(featureFlagName="multi_location") %}
    {{SetPersonaAttribute(id=user_id, field="multi_location_current_location", value="default")}}
{% endif %}

{{UpdateConversationMetaSkill(userId=user_id)}}

{% if (GetTriggeredAct().arguments.isSharedPhoneNumber == "true") or actor.connectorIdn == "newo_voice_connector_web" %}
    {{SetPersonaAttribute(id=user_id, field="temporal", value="True")}}
{% else %}
    {% set detected_phone_number_with_country_code = actor.externalId | string %}
    {{_utilsCreatePhoneActorsSkill(userId=user_id, phoneNumber=detected_phone_number_with_country_code)}}

    {# Define user's phone number in background  #}
    {{SendSystemEvent(
        eventIdn="define_user_phone_number",
        connectorIdn="system",
        user_id=user_id,
        user_phone_number_with_country_code=detected_phone_number_with_country_code
    )}}
{% endif %}

{{_startNewSessionSkill(user_id=user_id)}}

{{_utilsSendSystemLogSkill(message="New conversation started.")}}
{{SendSystemEvent(eventIdn="extend_session", connectorIdn="system")}}
