{% set user_id = GetUser().id | string %}
{% set triggered_act = GetTriggeredAct() %}

{# Hand the raw payload to the LLM already running for urgent_message; let it extract any user-facing message. Shape-agnostic across integrations. #}
{% set raw_payload = triggered_act.arguments | default({}, true) %}
{% set payload_json = json.dumps(raw_payload, ensure_ascii=False, indent=2, default=str) %}

{# Empty when payload is trivial; original prompts then byte-identical to main. #}
{% set integration_context = "" %}
{% if payload_json and payload_json != "{}" and payload_json != "null" %}
    {% set integration_context = "

Additionally, the booking integration returned the following raw payload. Read it carefully and look for any user-facing error message (e.g. 'slot taken', 'patient already booked', 'no availability', 'cancellation failed', 'invalid date').

If you find one, REPLACE the phrase 'there are technical issues with the system' in your response with the actual reason from the payload, conveyed in your own words in a natural and friendly tone. Do NOT say both 'technical issues' and the specific reason in the same response - pick one.

Strip technical jargon, status codes, internal field names, IDs, raw exceptions, and any HTML or stack-trace content from anything you read.

If the payload contains no clear user-facing message - only status codes, technical fields, or empty/null values - do NOT invent details; keep the original 'technical issues' wording as-is.

Payload:
```
" ~ payload_json ~ "
```" %}
{% endif %}

{# Three branches; each appends integration_context to its baseInstruction. #}
{% set define_during_working_hours_enabled = GetCustomerAttribute(field="project_attributes_setting_define_conversation_is_during_working_hours_enabled") %}
{% set transfer_call_enabled = GetCustomerAttribute(field="project_attributes_setting_transfer_call_enabled") %}

{% if define_during_working_hours_enabled == "True" and transfer_call_enabled == "True" %}
    {% if GetPersonaAttribute(id=user_id, field="working_hours_status") == "true" %}
        {{SendSystemEvent(
            eventIdn="urgent_message",
            connectorIdn="system",
            baseInstruction="Apologize to the user and say: 'I'm sorry, but it seems there are technical issues with the system. I can try to connect you with our manager who can help, would you like me to do that?'" ~ integration_context,
            uninterruptible="True"
        )}}
        {{Return()}}
    {% endif %}
{% endif %}

{% set session_ended_report_enabled = GetCustomerAttribute(field="project_attributes_setting_session_ended_report_enabled") %}
{% if session_ended_report_enabled == "True" %}
    {{SendSystemEvent(
        eventIdn="urgent_message",
        connectorIdn="system",
        baseInstruction="Apologize to the user and say: 'I'm sorry, but it seems there are technical issues with the system. Please leave a message, and I will relay everything to the manager. What would you like me to include?'" ~ integration_context,
        uninterruptible="True"
    )}}
{% else %}
    {{SendSystemEvent(
        eventIdn="urgent_message",
        connectorIdn="system",
        baseInstruction="Apologize to the user and say: 'I'm sorry, but it seems there are technical issues with the system. Please call again later.'" ~ integration_context,
        uninterruptible="True"
    )}}
{% endif %}
