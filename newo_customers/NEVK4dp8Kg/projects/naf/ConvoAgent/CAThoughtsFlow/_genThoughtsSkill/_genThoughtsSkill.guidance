{{~/system}}{{#assistant~}}{{Set(name="convoagent_thoughts", value=Gen(temperature=0.2, topP=0, skipFilter=True, thinkingBudget=300), expose=True)}}{{~/assistant}}

{{Set(name="thoughts", value=compile_thoughts(thoughts=convoagent_thoughts))}}

{{SetPersonaAttribute(field="convoagent_thoughts", value=thoughts, id=userId)}}

{{SendMessage(message=Concat("THOUGHTS:
", thoughts), actorIds=_utilsGetFootnoteSkill(userId=userId, thoughts="True"))}}

{{!-- Thoughts must not rewrite last convo actor id --}}
{{Set(name="last_convo_actor_id", value=GetPersonaAttribute(id=userId, field="last_convo_actor_id"))}}
{{#if not IsEmpty(text=last_convo_actor_id)}}
    {{#if GetActor(field="integrationIdn", id=last_convo_actor_id) == "newo_voice"}}
        {{Set(name="voice_mode", value=GetCustomerAttribute(field="project_attributes_setting_voice_integration_service_voice_mode"))}}
        {{#if voice_mode == "voice-to-voice"}}
            {{send_v2v_thoughts(thoughts=thoughts, last_convo_actor_id=last_convo_actor_id)}}
        {{/if}}
        {{#if voice_mode == "speech-to-speech"}}
            {{send_v2v_thoughts(thoughts=thoughts, last_convo_actor_id=last_convo_actor_id)}}
        {{/if}}
        {{!-- {{SendSystemEvent(eventIdn="update_current_prompt", connectorIdn="system", convoAgentAnswer=agentAnswer)}} --}}
    {{/if}}
{{/if}}

{{Return(val=convoagent_thoughts)}}
