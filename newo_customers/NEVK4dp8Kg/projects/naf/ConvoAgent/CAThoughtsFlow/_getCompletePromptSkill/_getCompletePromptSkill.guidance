{{_getExplicitConstraintsSkill(conversationChannel=conversation_channel, userId=userId)}}
</ExplicitConstraints>

{{_getWorkingHoursStatusBlockWrapper()}}

{{#if not IsEmpty(text=intent_type_map)}}
