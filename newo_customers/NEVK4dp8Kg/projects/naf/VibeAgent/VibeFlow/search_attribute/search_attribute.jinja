{% set parameters_parsed = json.loads(parameters) if parameters and parameters.strip() else [] %}
{% set query = parameters_parsed[0] if parameters_parsed else "" %}
{% set tenant = GetCustomerInfo().tenant | string %}
{% set is_newo_tenant = not tenant or tenant == "newo" %}
{% set customer_attributes = GetCustomerAttributes() %}

{% set searchable_attributes = [] %}
{% set searchable_attribute_idns = [] %}
{% set attributes_by_idn = {} %}
{% for attribute in customer_attributes %}
    {% set attribute_idn = attribute.idn if attribute.idn is defined else "" %}
    {% set attribute_idn_lower = attribute_idn.lower() %}
    {% if attribute_idn and "_private_dynamic_" not in attribute_idn_lower and "agent_creator" not in attribute_idn_lower %}
        {% set metadata = GetCustomerMetadataAttribute(idn=attribute_idn) %}
        {% set attribute_summary = {
            "idn": attribute_idn,
            "value": metadata.value if metadata and metadata.value is defined and metadata.value is not none else GetCustomerAttribute(field=attribute_idn).strip(),
            "title": metadata.title if metadata and metadata.title is defined and metadata.title is not none else (attribute.title if attribute.title is defined and attribute.title is not none else ""),
            "description": metadata.description if metadata and metadata.description is defined and metadata.description is not none else "",
            "group": metadata.group if metadata and metadata.group is defined and metadata.group is not none else (attribute.group if attribute.group is defined and attribute.group is not none else ""),
            "is_hidden": metadata.isHidden if metadata and metadata.isHidden is defined else false,
            "possible_values": metadata.possibleValues if metadata and metadata.possibleValues is defined else [],
            "value_type": (metadata.valueType if metadata and metadata.valueType is defined and metadata.valueType is not none else "") | string
        } %}
        {% set branding_check_text = json.dumps(attribute_summary, ensure_ascii=False, indent=2).lower() %}
        {% if is_newo_tenant or "newo" not in branding_check_text %}
            {{searchable_attributes.append(attribute_summary)}}
            {{searchable_attribute_idns.append(attribute_idn)}}
            {{attributes_by_idn.update({attribute_idn: attribute_summary})}}
        {% endif %}
    {% endif %}
{% endfor %}

{% if not searchable_attributes %}
    {% set thoughts = "I could not load searchable customer attributes for the query: `" ~ query ~ "`." %}
    {{SendMessage(message='<thinking>\n' ~ thoughts ~ '\n</thinking>', actorIds=[GetActor().id | string], useFilter=False)}}
    {{already_taken_actions.append(thoughts)}}
    {{main(memory=memory, already_taken_actions=already_taken_actions)}}
{% else %}
    {% set prompt %}You are the `search_attribute` action for Vibe Builder{% if is_newo_tenant %} at Newo{% endif %}. Vibe Builder passes you a semantic description of what it needs to understand or change in the AI Employee configuration.

Your job:
- Read <SearchIntent> as the user's configuration intent, not as a bag of keywords.
- Inspect every object in <SearchableAttributes>. Each object contains the full searchable metadata and current value.
- Return the customer attribute idns that are most relevant to the intent.
- If the intent exactly names an attribute idn, include it.
- Prefer a small, useful set. Return multiple attributes only when they are genuinely related or ambiguity is useful for the caller.
- Do not return the whole catalog.

<SearchIntent>
{{query}}
</SearchIntent>

<SearchableAttributes>
{{json.dumps(searchable_attributes, ensure_ascii=False, indent=2)}}
</SearchableAttributes>{% endset %}

    {% set schema = {
      "type": "object",
      "properties": {
        "related_attributes": {
            "type": "array",
            "items": {
                "type": "string",
                "description": "One of the customer attribute idns listed in SearchableAttributes",
                "enum": searchable_attribute_idns
            },
            "description": "Customer attributes to return to the main VibeAgent loop"
        }
      },
      "required": ["related_attributes"]
    } %}

    {% set result = json.loads(structured_generation(schema=schema, prompt=prompt)) %}
    {% set resolved_related_attributes = [] %}
    {% for attribute_idn in result.related_attributes %}
        {% set attribute = attributes_by_idn.get(attribute_idn) %}
        {% if attribute %}
            {{resolved_related_attributes.append(attribute)}}
        {% endif %}
    {% endfor %}

    {% set thoughts = '' %}
    {% if not resolved_related_attributes %}
        {% set thoughts = 'I did not find any customer attributes for the query: `' ~ query ~ '`' %}
    {% else %}
        {% set thoughts = "I have found the following customer attributes:\n\n" %}
    {% endif %}
    {% for attribute in resolved_related_attributes %}
        {% set attribute_value = attribute.value %}
        {% if attribute_value is none or not (attribute_value | string).strip() %}
            {% set attribute_value = '[No value]' %}
        {% endif %}
        {% set thoughts = thoughts ~ '**IDN:** `' ~ attribute.idn ~ '`\n**Current value:** ' ~ (attribute_value | string) ~ '\n' %}

        {% if attribute.title and attribute.title.strip() %}
            {% set thoughts = thoughts ~ '**Title:** ' ~ attribute.title.strip() ~ '\n' %}
        {% endif %}

        {% if attribute.description and attribute.description.strip() %}
            {% set thoughts = thoughts ~ '**Description:** ' ~ attribute.description.strip() ~ '\n' %}
        {% endif %}

        {% if attribute.group and attribute.group.strip() %}
            {% set thoughts = thoughts ~ '**Group:** ' ~ attribute.group.strip() ~ '\n' %}
        {% endif %}

        {% if attribute.is_hidden is not none %}
            {% set thoughts = thoughts ~ '**Is Hidden:** ' ~ attribute.is_hidden | string ~ '\n' %}
        {% endif %}

        {% if attribute.possible_values %}
            {% set thoughts = thoughts ~ '**Possible Values:** ' ~ json.dumps(attribute.possible_values, ensure_ascii=False, indent=2) ~ '\n' %}
        {% endif %}

        {% if attribute.value_type and attribute.value_type.strip() %}
            {% set thoughts = thoughts ~ '**Value Type:** ' ~ attribute.value_type.strip() ~ '\n' %}
        {% endif %}

        {% set thoughts = thoughts ~ '\n' %}
    {% endfor %}

    {{SendMessage(message='<thinking>\n' ~ thoughts ~ '\n</thinking>', actorIds=[GetActor().id | string], useFilter=False)}}
    {{already_taken_actions.append(thoughts)}}

    {{main(memory=memory, already_taken_actions=already_taken_actions)}}
{% endif %}
