{% set tenant = GetCustomerInfo().tenant | string %}
{% set is_newo_tenant = not tenant or tenant == "newo" %}
{% set customer_attributes = GetCustomerAttributes() %}

{% set searchable_attribute_idns = [] %}
{% for attribute in customer_attributes %}
    {% set attribute_idn = attribute.idn if attribute.idn is defined else "" %}
    {% set attribute_idn_lower = attribute_idn.lower() %}
    {% set attribute_title = (attribute.title if attribute.title is defined and attribute.title is not none else "") | string %}
    {% set attribute_group = (attribute.group if attribute.group is defined and attribute.group is not none else "") | string %}
    {% set branding_check_text = (attribute_idn ~ " " ~ attribute_title ~ " " ~ attribute_group).lower() %}
    {% if attribute_idn and "_private_dynamic_" not in attribute_idn_lower and "agent_creator" not in attribute_idn_lower and (is_newo_tenant or "newo" not in branding_check_text) %}
        {{searchable_attribute_idns.append(attribute_idn)}}
    {% endif %}
{% endfor %}

{{Return(val=json.dumps(searchable_attribute_idns, ensure_ascii=False, indent=2))}}
