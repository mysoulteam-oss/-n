{% set actor_id = GetActor().id | string %}

{% set parameters_parsed = json.loads(parameters) %}
{% set type_idn = parameters_parsed[0] %}
{% set item_idn = parameters_parsed[1] %}

{% set item_str = get_canvas_item(type_idn=type_idn, item_idn=item_idn) %}
{% set item = json.loads(item_str) if item_str else {} %}

{% if item %}
    {{execute_delete_canvas_item(type_idn=type_idn, item_idn=item_idn)}}
    {% set item_title = item.title if item.title is defined else '' %}
    {% set transaction = [{
        "revert_action": "execute_add_canvas_item",
        "revert_action_parameters": {"type_idn": type_idn, "item": item_str}
    }] %}
    {% set applied_change = {
        "action": "delete_canvas_item",
        "summary": "Deleted `" ~ type_idn ~ "` item `" ~ item_idn ~ "`.",
        "details": {
            "type_idn": type_idn,
            "item_idn": item_idn,
            "title": item_title
        }
    } %}
    {{add_transaction(transaction_id=transaction_id, transaction=json.dumps(transaction, ensure_ascii=False, indent=2))}}
    {{add_applied_change(change_id=transaction_id, change=json.dumps(applied_change, ensure_ascii=False, indent=2))}}
    {{SendMessage(message='<thinking>\nI have deleted the `' ~ type_idn ~ '` item `' ~ item_idn ~ '`.\n</thinking>', actorIds=[actor_id], useFilter=False)}}
    {{already_taken_actions.append('I have deleted the `' ~ type_idn ~ '` item `' ~ item_idn ~ '`.')}}
{% else %}
    {{SendMessage(message='<thinking>\nNo `' ~ type_idn ~ '` item with idn `' ~ item_idn ~ '` exists; nothing was deleted.\n</thinking>', actorIds=[actor_id], useFilter=False)}}
    {{already_taken_actions.append('No `' ~ type_idn ~ '` item with idn `' ~ item_idn ~ '` exists; nothing was deleted.')}}
{% endif %}

{{main(memory=memory, already_taken_actions=already_taken_actions)}}
