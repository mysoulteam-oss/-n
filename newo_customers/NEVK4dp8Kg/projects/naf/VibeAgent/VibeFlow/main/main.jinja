{% set project_business_name = GetCustomerAttribute(field="project_business_name").strip() %}
{% set outward_agent_name = project_representative_agent_name if project_representative_agent_name else "your AI Employee" %}
{% set outward_business_name = project_business_name if project_business_name else "your business" %}

{% if configured_depth_limit < 1 %}
    {% set configured_depth_limit = 20 %}
{% elif configured_depth_limit > 199 %}
    {% set configured_depth_limit = 199 %}
{% endif %}

{% if configured_main_thinking_budget < 1 %}
    {% set configured_main_thinking_budget = 145 %}
{% endif %}

{# Pin the latest user task in persona state so the loop does not lose it when memory is truncated. #}
{% if is_new_loop %}
    {{DeletePersonaAttribute(id=user_id, field=attribute_publish_requested_field)}}
    {{DeletePersonaAttribute(id=user_id, field=pending_canvas_review_type_field)}}
    {{DeletePersonaAttribute(id=user_id, field=pending_canvas_review_item_id_field)}}
