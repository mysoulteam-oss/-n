{% set schema = {
  "type": "object",
  "properties": {
    "decision_summary": {
      "type": "string",
      "description": "Briefly explain the current turn action choice based on the latest user task and relevant history. Do not repeat previous turn reasoning unless it is directly relevant."
    },
    "action": {
      "type": "string",
      "enum": allowed_actions,
      "description": "Action to execute"
    },
