{% set pending_canvas_review_type_field = "pending_canvas_review_type_" ~ actor_id_normalized %}
{% set pending_canvas_review_item_id_field = "pending_canvas_review_item_id_" ~ actor_id_normalized %}
{% set inspected_library_types_field = "inspected_library_types_" ~ actor_id_normalized %}
{% set last_message = GetPersonaAttribute(id=user_id, field=last_message_field) %}
{% set already_taken_actions = already_taken_actions or []%}
{# `already_taken_actions` is empty only on fresh entry from the user_message event subscription;
   recursive calls from action skills always pass the accumulated list. Using it as the
   new-loop discriminator is robust against a crashed previous session that left
   `last_message_*` set — preventing stale-task processing and stale-`attribute_publish_requested`
   leak into `project_publish_finish`. #}
{% set is_new_loop = not already_taken_actions %}
{% set configured_depth_limit = GetProjectAttribute(field="project_attributes_setting_vibe_loop_max_depth").strip() | int(default=20) %}
{% set configured_main_thinking_budget = GetProjectAttribute(field="project_attributes_setting_vibe_main_thinking_budget").strip() | int(default=1024) %}
