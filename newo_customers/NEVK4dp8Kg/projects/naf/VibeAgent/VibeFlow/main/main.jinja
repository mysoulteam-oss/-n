{% set action = json.loads(structured_generation(schema=schema, prompt=prompt, thinking_budget=configured_main_thinking_budget)) %}
{% set library_guard_thinking = "" %}
{% if action.action == "add_canvas_item" and action.action_params and (action.action_params | length) > 0 %}
    {% set add_canvas_item_type = action.action_params[0].strip() %}
    {% set library_backed_canvas_types = ["introduction", "intent_types", "scenarios", "procedures"] %}
    {% set inspected_library_types_raw = GetPersonaAttribute(id=user_id, field=inspected_library_types_field).strip() %}
    {% set inspected_library_types = json.loads(inspected_library_types_raw) if inspected_library_types_raw else [] %}
    {% if add_canvas_item_type in library_backed_canvas_types and add_canvas_item_type not in inspected_library_types %}
        {% set library_guard_thinking = "I have to check the library for `" ~ add_canvas_item_type ~ "` first before I can add a canvas item of that type, so I will inspect the library now." %}
        {{action.update({
            "decision_summary": library_guard_thinking,
            "action": "inspect_library",
            "action_params": [add_canvas_item_type]
        })}}
    {% endif %}
{% endif %}

{% set set_attribute_guard_thinking = "" %}
{% if action.action == "set_attribute" and action.action_params and (action.action_params | length) > 0 %}
    {% set rejected_idn = action.action_params[0].strip() %}
    {% set searchable_attribute_idns_raw = get_searchable_attribute_idns() %}
    {% set searchable_attribute_idns = json.loads(searchable_attribute_idns_raw) if searchable_attribute_idns_raw else [] %}
    {% if rejected_idn and searchable_attribute_idns and rejected_idn not in searchable_attribute_idns %}
        {% set set_attribute_guard_thinking = "I attempted to set attribute `" ~ rejected_idn ~ "` but that identifier is not in the searchable settings catalogue. I need to search the catalogue first to confirm whether a real attribute matches what I wanted to update." %}
        {% set descriptive_query = "Looking for an existing setting similar to `" ~ rejected_idn ~ "` for the task: " ~ last_message.strip() %}
        {{action.update({
            "decision_summary": set_attribute_guard_thinking,
            "action": "search_attribute",
            "action_params": [descriptive_query]
        })}}
    {% endif %}
{% endif %}

{% set get_attribute_guard_thinking = "" %}
{% if action.action == "get_attribute" and action.action_params and (action.action_params | length) > 0 %}
    {% set requested_idn = action.action_params[0].strip() %}
    {% set searchable_attribute_idns_raw = get_searchable_attribute_idns() %}
    {% set searchable_attribute_idns = json.loads(searchable_attribute_idns_raw) if searchable_attribute_idns_raw else [] %}
    {% if requested_idn and searchable_attribute_idns and requested_idn not in searchable_attribute_idns %}
        {% set get_attribute_guard_thinking = "I attempted to fetch full attribute `" ~ requested_idn ~ "` but that identifier is not in the searchable settings catalogue. I need to search the catalogue first to confirm whether a real attribute matches what I wanted to inspect." %}
        {% set descriptive_query = "Looking for an existing setting similar to `" ~ requested_idn ~ "` for the task: " ~ last_message.strip() %}
        {{action.update({
            "decision_summary": get_attribute_guard_thinking,
            "action": "search_attribute",
            "action_params": [descriptive_query]
        })}}
    {% endif %}
{% endif %}

{% set transaction_id = (uuid.uuid4() | string).replace('-', '') %}
{% set transaction_actions = ["set_attribute", "add_canvas_item", "edit_canvas_item", "delete_canvas_item"] %}
{% set current_checkpoint_id = GetPersonaAttribute(id=user_id, field=checkpoint_id_field).strip().replace('-', '') %}
{% if action.action in transaction_actions and not current_checkpoint_id %}
    {% set next_checkpoint_sequence = GetPersonaAttribute(id=user_id, field=checkpoint_counter_field).strip() | int(default=0) %}
    {% set next_checkpoint_sequence = next_checkpoint_sequence + 1 %}
    {% set current_checkpoint_id = (uuid.uuid4() | string).replace('-', '') %}
    {{SetPersonaAttribute(id=user_id, field=checkpoint_id_field, value=current_checkpoint_id)}}
    {{SetPersonaAttribute(id=user_id, field=checkpoint_sequence_field, value=next_checkpoint_sequence | string)}}
    {{SetPersonaAttribute(id=user_id, field=checkpoint_counter_field, value=next_checkpoint_sequence | string)}}
    {{create_checkpoint(checkpoint_id=current_checkpoint_id, checkpoint_sequence=next_checkpoint_sequence | string)}}
{% endif %}
{% if action.decision_summary %}
  {{SendMessage(message='<thinking>\n' ~ action.decision_summary ~ '\n</thinking>', actorIds=[actor_id], useFilter=False)}}
  {{ already_taken_actions.append(action.decision_summary) }}
{% endif %}
{% if action.action != 'reply' %}
    {{SendMessage(message='<log>\nExecuting `' ~ action.action ~ '` with parameters: `' ~ json.dumps(action.action_params, ensure_ascii=False, indent=2) ~ '`\n<transaction_id>' ~ transaction_id ~ '</transaction_id>\n</log>', actorIds=[actor_id], useFilter=False)}}
    {{ already_taken_actions.append('<log>\nExecuting `' ~ action.action ~ '` with parameters: `' ~ json.dumps(action.action_params, ensure_ascii=False, indent=2) ~ '`\n<transaction_id>' ~ transaction_id ~ '</transaction_id>\n</log>') }}
{% endif %}
{{Do(actionName=action.action, parameters=json.dumps(action.action_params, ensure_ascii=False, indent=2), transaction_id=transaction_id, already_taken_actions=already_taken_actions, memory=memory)}}
