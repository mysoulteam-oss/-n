{% set pattern = "\\[\\[([a-zA-Z_][a-zA-Z0-9_]*)\\]\\]" %}

{% set compiled_text = text %}
{% set attributes = re.findall(pattern, compiled_text) | unique %}

{% for attribute in attributes %}
    {% if attribute not in (exclude_attributes or []) %}
        {% set compiled_text = compiled_text.replace("[[" ~ attribute ~ "]]", GetCustomerAttribute(field=attribute)) %}
    {% endif %}
{% endfor %}

{{Return(val=compiled_text)}}
