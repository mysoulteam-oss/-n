{{!-- ! Important: AKB is built from AKB Template during Setup, not Post-Setup --}}

{{!-- Post-setup Connector creation happens after Agent Creator callback is sent --}}
{{prepare_connectors_post_setup()}}

{{!-- Setting common Customer Attributes --}}
{{_prepareAttributesCommonPrivateDynamicWorkScheduleSkill()}}
{{_prepareAttributesCommonPrivateDynamicProductsAndServicesSkill()}}

{{!-- TODO: remove later - was added because `_prepareAttributesCommonPrivateDynamicWorkScheduleObjectSkill` is called after setting up Metadata --}}
{{_utilsCustomerAttributeSetIfEmptySkill(field="project_attributes_private_dynamic_schedule_working_hours_object", value=" ")}}

{{!-- Setting industry-specific Customer Attributes --}}
{{Set(name="industry", value=GetCustomerAttribute(field="project_business_industry") )}}

{{!-- Note: re-building of `Dynamic Business Context` and `Dynamic Tech Variables` must be called after building `Products And Services` because it's value is being injected into these `Dynamic` Attributes --}}

{{#if industry == "catering_industry"}}
    {{_prepareAttributesCateringPrivateDynamicBusinessContextSkill()}}
    {{_prepareAttributesCateringPrivateDynamicTechVariablesSkill()}}
    {{_prepareAkbCateringMenuRagSkill()}}
    {{_prepareAttributesCommonMetadataSkill(triggered_by=triggered_by)}}
    {{_prepareAttributesCateringMetadataSkill(triggered_by=triggered_by)}}
{{/if}}

{{#if industry == "cleaning_industry"}}
    {{_prepareAttributesCleaningPrivateDynamicBusinessContextSkill()}}
    {{_prepareAttributesCleaningPrivateDynamicTechVariablesSkill()}}
    {{_prepareAttributesCommonMetadataSkill(triggered_by=triggered_by)}}
    {{_prepareAttributesCleaningMetadataSkill(triggered_by=triggered_by)}}
{{/if}}

{{#if industry == "dental_industry"}}
    {{_prepareAttributesDentalPrivateDynamicBusinessContextSkill()}}
    {{_prepareAttributesDentalPrivateDynamicTechVariablesSkill()}}
    {{_prepareAttributesCommonMetadataSkill(triggered_by=triggered_by)}}
    {{_prepareAttributesDentalMetadataSkill(triggered_by=triggered_by)}}
{{/if}}

{{#if industry == "home_service_industry"}}
    {{_prepareAttributesHomeServicePrivateDynamicBusinessContextSkill()}}
    {{_prepareAttributesHomeServicePrivateDynamicTechVariablesSkill()}}
    {{_prepareAttributesCommonMetadataSkill(triggered_by=triggered_by)}}
    {{_prepareAttributesHomeServiceMetadataSkill(triggered_by=triggered_by)}}
{{/if}}

{{#if industry == "hospitality_industry"}}
    {{_prepareAttributesHospitalityPrivateDynamicBusinessContextSkill()}}
    {{_prepareAttributesHospitalityPrivateDynamicTechVariablesSkill()}}
    {{_prepareAttributesCommonMetadataSkill(triggered_by=triggered_by)}}
    {{_prepareAttributesHospitalityMetadataSkill(triggered_by=triggered_by)}}
{{/if}}

{{#if industry == "restaurant_industry"}}
    {{_prepareAttributesRestaurantPrivateDynamicBusinessContextSkill()}}
    {{_prepareAttributesRestaurantPrivateDynamicTechVariablesSkill()}}
    {{_prepareAkbRestaurantMenuRagSkill()}}
    {{_prepareAttributesCommonMetadataSkill(triggered_by=triggered_by)}}
    {{_prepareAttributesRestaurantMetadataSkill(triggered_by=triggered_by)}}
{{/if}}

{{#if industry == "sales_industry"}}
    {{_prepareAttributesSalesPrivateDynamicBusinessContextSkill()}}
    {{_prepareAttributesSalesPrivateDynamicTechVariablesSkill()}}
    {{_prepareAttributesCommonMetadataSkill(triggered_by=triggered_by)}}
    {{_prepareAttributesSalesMetadataSkill(triggered_by=triggered_by)}}
{{/if}}

{{#if industry == "beauty_industry"}}
    {{_prepareAttributesBeautyPrivateDynamicBusinessContextSkill()}}
    {{_prepareAttributesBeautyPrivateDynamicTechVariablesSkill()}}
    {{_prepareAttributesCommonMetadataSkill(triggered_by=triggered_by)}}
    {{_prepareAttributesBeautyMetadataSkill(triggered_by=triggered_by)}}
{{/if}}

{{#if industry == "general_industry"}}
    {{_prepareAttributesGeneralPrivateDynamicBusinessContextSkill()}}
    {{_prepareAttributesGeneralPrivateDynamicTechVariablesSkill()}}
    {{_prepareAttributesCommonMetadataSkill(triggered_by=triggered_by)}}
    {{_prepareAttributesGeneralMetadataSkill(triggered_by=triggered_by)}}
{{/if}}

{{!-- Disable the explicit manual metadata initialization flag after metadata setup completes --}}
{{SetProjectAttribute(field="project_attributes_setting_init_attributes_metadata_enabled", value="False")}}

{{rag_append_from_text()}}

{{rag_append_from_websites()}}

{{!-- Being triggered after setting up metadata because this Skill is not stable at the moment generation fails in some cases --}}
{{#if GetCustomerAttribute(field="project_attributes_setting_working_hours_structured_format_enabled") == "True"}}
  {{_prepareAttributesCommonPrivateDynamicWorkScheduleCompiledSkill()}}
{{else}}
  {{_prepareAttributesCommonPrivateDynamicWorkScheduleObjectSkill()}}
{{/if}}

{{_updateConnectorSettingsNewoChatSkill()}}

{{!-- TODO: Move to a separate skill --}}
{{!-- Set `bypass / emergency phone number` Attribute if not set --}}
{{Set(name="bypass_phone_number", value=GetCustomerAttribute(field="project_attributes_setting_voice_integration_service_bypass_phone_number"))}}
{{#if IsEmpty(text=bypass_phone_number)}}
  {{Set(name="agent_voice_phone_number", value=GetCustomerAttribute(field="project_representative_agent_voice_phone_number"))}}
  {{Set(name="public_phone", value=GetCustomerAttribute(field="project_business_public_phone"))}}
  {{Set(name="working_hour_escalation_phone", value=GetCustomerAttribute(field="project_business_working_hour_escalation_phone"))}}

  {{Set(name="asr_redirection_type_working_hours", value=GetCustomerAttribute(field="project_attributes_setting_asr_redirection_type_working_hours"))}}
  {{!-- If `non-overflow`, recursion might happen in case of public phone usage --}}
  {{!-- (our system transfers to public phone, while call is being redirected back to Agent) --}}
  {{!-- So it is better to use escalation phone number instead of public phone --}}
  {{!-- If escalation phone number is the same as agent phone, we must not set any number at all --}}
  {{#if asr_redirection_type_working_hours == "non-overflow"}}
    {{!-- If escalation phone number is the same as agent phone, we must not set any number at all --}}
    {{#if agent_voice_phone_number == working_hour_escalation_phone}}
      {{Return()}}
    {{/if}}
    {{#if not IsEmpty(text=working_hour_escalation_phone)}}
      {{SetCustomerAttribute(field="project_attributes_setting_voice_integration_service_bypass_phone_number", value=working_hour_escalation_phone)}}
    {{/if}}
  {{/if}}

  {{!-- If `overflow`, there is a possibility of recursion but it is less probable so we can use public phone --}}
  {{!-- We need to check that public phone is not agent phone and use escalation phone number as a fallback --}}
  {{#if asr_redirection_type_working_hours == "overflow"}}
    {{#if agent_voice_phone_number == public_phone}}
      {{!-- If escalation phone number is the same as agent phone, we must not set any number at all --}}
      {{#if agent_voice_phone_number == working_hour_escalation_phone}}
        {{Return()}}
      {{/if}}
      {{#if not IsEmpty(text=working_hour_escalation_phone)}}
        {{SetCustomerAttribute(field="project_attributes_setting_voice_integration_service_bypass_phone_number", value=working_hour_escalation_phone)}}
      {{/if}}
    {{else}}
      {{#if not IsEmpty(text=public_phone)}}
        {{SetCustomerAttribute(field="project_attributes_setting_voice_integration_service_bypass_phone_number", value=public_phone)}}
      {{/if}}
    {{/if}}
  {{/if}}
{{/if}}
