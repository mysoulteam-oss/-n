{{set_customer_attribute_from_ac_if_first_init_and_empty(is_first_init_done=is_first_init_done, naf_field="project_attributes_catering_menu_url", ac_field="agent_creator_catering_menu_url")}}

{{set_customer_attribute_from_ac_if_first_init_and_empty(is_first_init_done=is_first_init_done, naf_field="project_attributes_catering_opentable_url", ac_field="agent_creator_catering_opentable_url")}}

{{set_customer_attribute_from_ac_if_first_init_and_empty(
