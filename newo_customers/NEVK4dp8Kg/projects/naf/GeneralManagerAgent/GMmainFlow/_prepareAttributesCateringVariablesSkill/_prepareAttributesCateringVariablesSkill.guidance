{{Set(name="is_first_init_done", value=GetCustomerAttribute(field="project_attributes_private_account_initialized_first_time"))}}
{{!-- All `catering` Customer Attributes must be specified here with default values --}}
{{!-- (must be sorted alphabetically) --}}

{{!-- Set of `catering` attributes from Agent Creator and BOQ defaults --}}

{{set_customer_attribute_from_ac_if_first_init_and_empty(
  is_first_init_done=is_first_init_done,
  naf_field="project_attributes_catering_deposit",
  ac_field="agent_creator_catering_deposit",
  default="700"
)}}

{{set_customer_attribute_from_ac_if_first_init_and_empty(
  is_first_init_done=is_first_init_done,
  naf_field="project_attributes_catering_deposit_covered_number_of_people",
  ac_field="agent_creator_catering_deposit_covered_number_of_people",
  default="40"
)}}

{{set_customer_attribute_from_ac_if_first_init_and_empty(
  is_first_init_done=is_first_init_done,
  naf_field="project_attributes_catering_email",
  ac_field="agent_creator_catering_email",
  default="[[project_business_manager_email]]"
)}}

{{set_customer_attribute_from_ac_if_first_init_and_empty(is_first_init_done=is_first_init_done, naf_field="project_attributes_catering_googlemaps_url", ac_field="agent_creator_catering_googlemaps_url")}}

