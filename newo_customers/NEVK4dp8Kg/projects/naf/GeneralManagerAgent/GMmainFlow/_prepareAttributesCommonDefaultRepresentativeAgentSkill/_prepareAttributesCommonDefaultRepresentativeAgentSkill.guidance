{{_utilsCustomerAttributeSetIfEmptySkill(field="project_representative_agent_voice_speaking_style", value="Friendly professional, super welcoming. Speak energetic and fast.")}}

{{set_customer_attribute_from_ac_if_first_init_and_empty(is_first_init_done=is_first_init_done, naf_field="project_representative_agent_title", ac_field="agent_creator_agent_info_title")}}

{{Set(name="agent_creator_voice_channel_disclaimer_phrase", value=GetCustomerAttribute(field="agent_creator_voice_channel_disclaimer_phrase"))}}
{{#if not IsEmpty(text=agent_creator_voice_channel_disclaimer_phrase)}}
  {{set_customer_attribute_from_ac_if_first_init_and_empty(is_first_init_done=is_first_init_done, naf_field="project_representative_agent_voice_disclaimer_phrase", ac_field="agent_creator_voice_channel_disclaimer_phrase")}}
{{else}}
  {{Set(name="language_primary", value=GetCustomerAttribute(field="project_representative_agent_primary_language"))}}
  {{utils_customer_attribute_set_if_empty_depending_on_language(
      attribute_idn="project_representative_agent_voice_disclaimer_phrase",
      input_text="This call may be recorded.",
      input_text_language="English",
      target_language=language_primary
  )}}
{{/if}}

{{!-- TODO: check that `agent_creator_agent_info_gender` falls under allowed values set: `auto`, `female`, `male`  --}}
{{Set(name="agent_gender", value=GetCustomerAttribute(field="agent_creator_agent_info_gender"))}}
{{#if not IsEmpty(text=agent_gender)}}
  {{set_customer_attribute_from_ac_if_first_init_and_empty(is_first_init_done=is_first_init_done, naf_field="project_representative_agent_gender", ac_field="agent_creator_agent_info_gender")}}
{{else}}
  {{Set(name="agent_gender", value=_prepareAgentGenderSkill())}}
  {{_utilsCustomerAttributeSetIfEmptySkill(field="project_representative_agent_gender", value=agent_gender)}}
{{/if}}

