  {{_utilsCustomerAttributeSetIfEmptySkill(field="project_attributes_setting_voice_integration_service_voice_to_voice_provider_openai_voice", value="Male - Cedar")}}
  {{_utilsCustomerAttributeSetIfEmptySkill(field="project_attributes_setting_voice_integration_service_voice_to_voice_provider_grok_voice", value="Male Rex - Confident")}}
{{/if}}

