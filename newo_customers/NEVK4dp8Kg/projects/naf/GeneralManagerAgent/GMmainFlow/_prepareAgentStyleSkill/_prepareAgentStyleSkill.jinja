{# TODO: Refactor, potentially, rename Skill or split it into multiple skills #}

{% set current_agent_style_voice = GetCustomerAttribute(field="project_representative_agent_voice_speaking_style") %}

{% set default_agent_style = "Friendly professional, super welcoming. Speak energetic and fast." %}
{% set project_business_language_primary = GetCustomerAttribute(field="project_business_language_primary").strip() %}
{% set accent_not_needed_languages = [
  "Hindi", "Japanese", "Korean", "Mandarin", "Cantonese", "Bengali", "Telugu", "Tamil",
  "Marathi", "Gujarati", "Malayalam", "Punjabi", "Ukrainian", "Thai", "Vietnamese", "Turkish",
  "Persian", "Hebrew", "Polish", "Greek", "Hungarian", "Czech", "Romanian", "Serbian",
  "Swahili", "Amharic", "Burmese", "Lao", "Khmer", "Pashto", "Urdu"
] %}

{% if current_agent_style_voice.strip() and (current_agent_style_voice != default_agent_style) %}
    {{ Return(val=current_agent_style_voice) }}
{% endif %}

{% if project_business_language_primary in accent_not_needed_languages %}
    {{ Return(val=default_agent_style) }}
{% endif %}

{% set prompt %}
Your goal is to define an accent / regional language variety / dialect for a voice AI agent for accurate speech pronunciation by building a JSON object based on <BusinessInformation>, using the description in the provided schema and rules specified in <Rules> below.

<BusinessInformation>
**Business name**: {{GetCustomerAttribute(field="project_business_name")}}
**Business country**: {{GetCustomerAttribute(field="project_business_country")}}
**Business address**: {{GetCustomerAttribute(field="project_business_address")}}
**Business language**: {{GetCustomerAttribute(field="project_representative_agent_primary_language")}}
</BusinessInformation>

<Rules>
## Specify accent if both of the following are satisfied:
1. if specifying accent / regional language variety / dialect clearly adds meaningful context for speech pronunciation (e.g., 'British' vs. 'American').
2. if the business language is spoken in multiple regions and those regions have distinct, widely recognized accents / regional language varieties / dialects, such as English, Spanish, or French. Set only widely recognized standard labels for the `accent` field.

## No need to define accent (leave field `accent` as empty) if any of these conditions below is true:
- If the accent / regional language variety / dialect is already obvious from the country (e.g., do not use 'American' if the country is the USA)
- If the information is not enough to choose an accent / regional language variety / dialect
- If `country` is United States and business language is English
- If `country` is France and business language is French
- If `country` is Mexico and business language is Spanish

## Important:
You are allowed to set the value of `accent` field to only existing widely recognized label of accent / regional language variety / dialect. You are not allowed to invent a non-existing one.
</Rules>{% endset %}

{% set schema = {
  "type": "object",
  "properties": {
    "accent": {
      "type": "string",
      "description": "Define accent / regional language variety / dialect for the business. Leave as empty string if it does not need to be specified."
    }
  },
  "required": ["accent"]
} %}


{% set result_json = json.loads(utils_structured_generation(schema=schema, prompt=prompt)) %}

{% set accent = result_json.accent %}
{% if accent.strip() and accent.strip() != project_business_language_primary %}
    {% set accent_instruction = " You speak with " ~ accent ~ " accent." %}
    {% set agent_style = default_agent_style ~ accent_instruction %}
    {{ Return(val=agent_style) }}
{% endif %}

{{Return(val=default_agent_style)}}
