{{Set(name="is_first_init_done", value=GetCustomerAttribute(field="project_attributes_private_account_initialized_first_time"))}}
{{!-- All `general` Customer Attributes must be specified here with default values --}}
{{!-- (must be sorted alphabetically) --}}

{{!-- Set of `general` attributes from Agent Creator and BOQ defaults --}}

{{set_customer_attribute_from_ac_if_first_init_and_empty(
  is_first_init_done=is_first_init_done,
  naf_field="project_attributes_general_appointment_check_in_notes",
  ac_field="agent_creator_general_appointment_check_in_notes"
)}}

{{set_customer_attribute_from_ac_if_first_init_and_empty(
  is_first_init_done=is_first_init_done,
  naf_field="project_attributes_general_appointment_scenario_link_guidance_instruction",
  ac_field="agent_creator_general_appointment_scenario_link_guidance_instruction",
  default="*(No additional guidance was provided.)*"
)}}

{{set_customer_attribute_from_ac_if_first_init_and_empty(
  is_first_init_done=is_first_init_done,
  naf_field="project_attributes_general_appointment_url",
  ac_field="agent_creator_general_appointment_url"
)}}

{{set_customer_attribute_from_ac_if_first_init_and_empty(
  is_first_init_done=is_first_init_done,
  naf_field="project_attributes_general_modality",
  ac_field="agent_creator_general_modality",
  default="followup"
)}}
