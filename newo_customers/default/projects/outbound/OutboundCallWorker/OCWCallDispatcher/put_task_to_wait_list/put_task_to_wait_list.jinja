{# Store queued calls in AKB to act as internal queue #}
{# To prevent async IO corruption storing the internal queue in the AKB #}

{% set agent_persona_id = GetAgentPersona().id | string %}
{% set task_obj = json.loads(task) %}
{% set queued_calls = SearchFuzzyAkb(
    query="queued_calls",
    searchFields=["name"],
    numberTopics=1,
    scoreThreshold=1,
    labels=["queued_calls"],
    filterByPersonaIds=[agent_persona_id]
) %}
{% if queued_calls %}
    {% set queue = json.loads(queued_calls[0].summary) %}
    {% set queued_tasks = namespace(tasks=[], found=False) %}
    {% for queued_task in queue %}
        {% if queued_task.id == task_obj.id %}
            {% set queued_tasks.tasks = queued_tasks.tasks + [task_obj] %}
            {% set queued_tasks.found = True %}
        {% else %}
            {% set queued_tasks.tasks = queued_tasks.tasks + [queued_task] %}
        {% endif %}
    {% endfor %}
    {% if not queued_tasks.found %}
        {% set queued_tasks.tasks = queued_tasks.tasks + [task_obj] %}
    {% endif %}
    {{UpdateAkb(id=queued_calls[0].topicId|string, summary=json.dumps(queued_tasks.tasks, ensure_ascii=False, indent=2))}}
{% else %}
    {{SetManualAkb(
        personaId=agent_persona_id,
        summary=json.dumps([task_obj], ensure_ascii=False, indent=2),
        facts=[],
        name="queued_calls",
        source="OCWCallDispatcher",
        labels=["queued_calls"]
    )}}
{% endif %}
