{{! Type LLM Prompt for non-structured generation here }}
{{#system~}}

{{~/system}}

{{#if IsEmpty(text=GetCurrentPrompt())}}
    {{Return()}}
{{/if}}

{{#assistant~}}{{Set(name="response", value=Gen(temperature=0.2, topP=0.5, skipFilter=True, thinkingBudget=170))}}{{~/assistant}}
{{SendMessage(message=response)}}
