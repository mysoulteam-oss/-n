{# Delete NEWO Voice and Twilio Connectors if country code / area code were changed - part 1 (remaining code is located at the bottom) #}

{# TODO: Obtain settings from Twilio Connector instead when `GetConnectorInfo` will return correct information for Twilio Connector #}
{# TODO: Enable later - buying a new phone number when country code or area code was disabled for timing optimization reason #}
{% set old_country_code = GetCustomerAttribute(field="project_representative_agent_voice_phone_alpha2_code") %}
{% set old_area_code = GetCustomerAttribute(field="project_representative_agent_voice_phone_area_code") %}
{% set old_fallback_area_code = GetCustomerAttribute(field="project_representative_agent_voice_phone_fallback_area_code") %}
{% set old_voice_phone_country_code = GetCustomerAttribute(field="project_representative_agent_voice_phone_country_code") %}
{% set old_voice_phone_number = GetCustomerAttribute(field="project_representative_agent_voice_phone_number") %}

{# ? What about Customer Attributes related to other projects? #}
{{BulkDeleteCustomerAttributes()}}

{# Keep the existing provisioned voice phone while reinit intentionally skips buying a new number. #}
{% if old_country_code.strip() %}
    {{SetCustomerAttribute(field="project_representative_agent_voice_phone_alpha2_code", value=old_country_code)}}
{% endif %}
{% if old_area_code.strip() %}
    {{SetCustomerAttribute(field="project_representative_agent_voice_phone_area_code", value=old_area_code)}}
{% endif %}
{% if old_voice_phone_country_code.strip() %}
    {{SetCustomerAttribute(field="project_representative_agent_voice_phone_country_code", value=old_voice_phone_country_code)}}
{% endif %}
{% if old_fallback_area_code.strip() %}
    {{SetCustomerAttribute(field="project_representative_agent_voice_phone_fallback_area_code", value=old_fallback_area_code)}}
{% endif %}
{% if old_voice_phone_number.strip() %}
    {{SetCustomerAttribute(field="project_representative_agent_voice_phone_number", value=old_voice_phone_number)}}
{% endif %}

{# Reinit must notify Agent Creator when the next customer phone call starts and finishes. #}
{{SetCustomerAttribute(field="project_attributes_private_dynamic_first_customer_call_events_must_be_sent", value="True")}}

{# ! TODO: Replace with Action for deletion of AKB when implemented #}

{% set general_manager_agent_persona_id = GetAgent(idn="GeneralManagerAgent").persona_id %}
{% set found_topics = SearchFuzzyAkb(
    query="",
    searchFields=["name"],
    numberTopics=99999,
    filterByPersonaIds=[general_manager_agent_persona_id],
    scoreThreshold=0.0
) %}
{% set topic_ids = [] %}
{% for topic in found_topics %}
    {% set _ = topic_ids.append(topic.topicId) %}
{% endfor %}
{{DeleteAkb(ids=topic_ids)}}

{% set convo_agent_persona_id = GetAgent(idn="ConvoAgent").persona_id %}
{% set found_topics = SearchFuzzyAkb(
    query="",
    searchFields=["name"],
    numberTopics=99999,
    filterByPersonaIds=[convo_agent_persona_id],
    scoreThreshold=0.0
) %}
{% set topic_ids = [] %}
{% for topic in found_topics %}
    {% set _ = topic_ids.append(topic.topicId) %}
{% endfor %}
{{DeleteAkb(ids=topic_ids)}}

{# Create Agent Customer Customer Attributes obtained from the event #}

{% for attribute in agent_creator_attributes %}
    {{SetCustomerAttribute(field=attribute.idn, value=attribute.value)}}
    {{SetCustomerMetadataAttribute(
        idn=attribute.idn,
        field="multiple_fields",
        value={
            "group": attribute.group | default("0. Agent Creator"),
            "is_hidden": attribute.is_hidden | default(true)
        }
    )}}
{% endfor %}

