{# Update Organization name #}
{% set business_info_name = GetCustomerAttribute(field="agent_creator_business_info_name") %}
{% if business_info_name.strip() %}
    {{SetCustomerInfo(organizationName=business_info_name)}}
{% endif %}

{# Update currency #}
{% set currency = GetCustomerAttribute(field="agent_creator_business_info_currency") %}
{% if currency.strip() %}
    {{SetCustomerInfo(currency=currency)}}
{% endif %}

{# Trigger SuperAgent Init process #}

{{SetProjectAttribute(field="project_attributes_setting_init_attributes_metadata_enabled", value="True")}}

{{SendSystemEvent(
    eventIdn="project_publish_finish",
    connectorIdn="project",
    global="True",
    triggered_by="force_update",
    registry_item_idn="naf",
    force_agent_creator_callback="True",
    force_demo_init="True"
)}}
