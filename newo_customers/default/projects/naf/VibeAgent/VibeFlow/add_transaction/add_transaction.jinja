{% set user_id = GetUser().id | string %}
{% set actor_id_normalized = (GetActor().id | string).replace('-', '') %}
{% set persona_field = "transaction_" ~ actor_id_normalized %}
{% set metadata_field = "transaction_metadata_" ~ actor_id_normalized %}
{% set transaction_key = transaction_id.replace('-', '') %}
{% set transactions = json.loads(get_transaction(transaction_id='')) %}
{% set transaction_metadata = json.loads(get_transaction_metadata(transaction_id='')) %}
{% set checkpoint_id = GetPersonaAttribute(id=user_id, field="checkpoint_id_" ~ actor_id_normalized).strip().replace('-', '') %}
{% set checkpoint_sequence = GetPersonaAttribute(id=user_id, field="checkpoint_sequence_" ~ actor_id_normalized).strip() | int(default=0) %}

{{transactions.update({
    transaction_key: json.loads(transaction)
})}}
{{transaction_metadata.update({
    transaction_key: {
        "checkpoint_id": checkpoint_id,
        "checkpoint_sequence": checkpoint_sequence
    }
})}}

{{SetPersonaAttribute(
    id=user_id,
    field=persona_field,
    value=json.dumps(transactions, ensure_ascii=False, indent=2)
)}}
{{SetPersonaAttribute(
    id=user_id,
    field=metadata_field,
    value=json.dumps(transaction_metadata, ensure_ascii=False, indent=2)
)}}
{{send_transactions_update()}}
