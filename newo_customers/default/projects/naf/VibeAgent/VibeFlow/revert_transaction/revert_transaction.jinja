{% set act = GetTriggeredAct() %}
{% set user_id = GetUser().id | string %}
{% set actor_id = GetActor().id | string %}
{% set actor_id_normalized = (GetActor().id | string).replace('-', '') %}
{% set persona_field = "transaction_" ~ actor_id_normalized %}
{% set metadata_field = "transaction_metadata_" ~ actor_id_normalized %}
{% set transaction_id = act.arguments.transaction_id.replace('-', '') %}
{% set transaction = json.loads(get_transaction(transaction_id=transaction_id)) %}
{% set transaction_metadata = json.loads(get_transaction_metadata(transaction_id=transaction_id)) %}
{% if not transaction %}
    {{Return()}}
{% endif %}
{% for commit in transaction %}
    {{Do(actionName=commit.revert_action, **commit.revert_action_parameters)}}
    {{Sleep(duration="2", interruptible="False")}}
{% endfor %}

{% set transactions = json.loads(get_transaction(transaction_id='')) %}
{{transactions.pop(transaction_id)}}
{% set all_transaction_metadata = json.loads(get_transaction_metadata(transaction_id='')) %}
{{all_transaction_metadata.pop(transaction_id)}}
{% set removed_checkpoint_ids = [] %}
{% if transactions %}
    {{SetPersonaAttribute(id=user_id, field=persona_field, value=json.dumps(transactions, ensure_ascii=False, indent=2))}}
{% else %}
    {{DeletePersonaAttribute(id=user_id, field=persona_field)}}
{% endif %}
{% if all_transaction_metadata %}
    {{SetPersonaAttribute(id=user_id, field=metadata_field, value=json.dumps(all_transaction_metadata, ensure_ascii=False, indent=2))}}
{% else %}
    {{DeletePersonaAttribute(id=user_id, field=metadata_field)}}
{% endif %}
{{remove_applied_change(change_id=transaction_id)}}
{% set checkpoint_id = transaction_metadata.get("checkpoint_id", "").replace('-', '') %}
{% if checkpoint_id %}
    {% set has_checkpoint_transactions = false %}
    {% for metadata in all_transaction_metadata.values() %}
        {% if metadata.get("checkpoint_id", "").replace('-', '') == checkpoint_id %}
            {% set has_checkpoint_transactions = true %}
        {% endif %}
    {% endfor %}
    {% if not has_checkpoint_transactions %}
        {{DeletePersonaAttribute(id=user_id, field="checkpoint_" ~ checkpoint_id)}}
        {{removed_checkpoint_ids.append(checkpoint_id)}}
        {% set active_checkpoint_id = GetPersonaAttribute(id=user_id, field="checkpoint_id_" ~ actor_id_normalized).strip().replace('-', '') %}
        {% if active_checkpoint_id == checkpoint_id %}
            {{DeletePersonaAttribute(id=user_id, field="checkpoint_id_" ~ actor_id_normalized)}}
            {{DeletePersonaAttribute(id=user_id, field="checkpoint_sequence_" ~ actor_id_normalized)}}
        {% endif %}
    {% endif %}
{% endif %}
{{send_transactions_update()}}
{% if removed_checkpoint_ids %}
{{SendCommand(
   commandIdn="revert_to_checkpoint_success",
   integrationIdn="newo_chat",
   connectorIdn="vibe_agent",
   user_actor_id=actor_id,
   checkpoint_ids=json.dumps(removed_checkpoint_ids, indent=2, ensure_ascii=False)
)}}
{% endif %}

{{SendSystemEvent(
    eventIdn="project_publish_finish",
    connectorIdn="project",
    triggered_by="vibe_builder_revert",
    registry_item_idn="naf",
    global="True"
)}}
