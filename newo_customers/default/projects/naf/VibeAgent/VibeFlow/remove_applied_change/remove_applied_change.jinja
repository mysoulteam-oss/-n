{% set user_id = GetUser().id | string %}
{% set actor_id_normalized = (GetActor().id | string).replace('-', '') %}
{% set persona_field = "applied_changes_" ~ actor_id_normalized %}
{% set change_key = change_id.replace('-', '') %}
{% set applied_changes_raw = GetPersonaAttribute(id=user_id, field=persona_field).strip() %}

{% if not applied_changes_raw or not change_key %}
    {{Return()}}
{% endif %}

{% set applied_changes = json.loads(applied_changes_raw) %}
{% if change_key not in applied_changes %}
    {{Return()}}
{% endif %}

{{applied_changes.pop(change_key)}}
{% if applied_changes %}
    {{SetPersonaAttribute(id=user_id, field=persona_field, value=json.dumps(applied_changes, ensure_ascii=False, indent=2))}}
{% else %}
    {{DeletePersonaAttribute(id=user_id, field=persona_field)}}
{% endif %}
