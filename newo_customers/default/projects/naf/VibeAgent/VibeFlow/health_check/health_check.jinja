    {% endif %}
{% endfor %}

{% if voice_enabled and value_by_idn.get("project_attributes_private_dynamic_voice_greeting_phrase", "").strip() == "" %}
    {{det_critical_findings.append({
        "attribute_idn": "project_attributes_private_dynamic_voice_greeting_phrase",
        "severity": "CRITICAL",
        "rule": "silent_greeting",
        "remediation": "hand_off",
        "quoted_value": "",
