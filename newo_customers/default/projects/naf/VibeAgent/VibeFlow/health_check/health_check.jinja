        "det_authoritative": True
    })}}
{% endif %}

{% if GetCustomerAttribute(field="project_attributes_setting_booking_check_availability_enabled").strip() == "True"
      and value_by_idn.get("project_attributes_private_dynamic_booking_check_availability_payload_schema_compiled", "").strip() == "" %}
    {{det_critical_findings.append({
        "attribute_idn": "project_attributes_private_dynamic_booking_check_availability_payload_schema_compiled",
        "severity": "CRITICAL",
        "rule": "booking_artifact_missing",
        "remediation": "hand_off",
        "quoted_value": "",
        "explanation": "Availability checking is enabled but its compiled availability payload schema is empty, so the agent cannot check availability on a call. Which booking integration should drive availability?",
        "det_authoritative": True
    })}}
{% endif %}

{% set lang_primary = (value_by_idn.get("project_business_language_primary", "") | string).strip() %}
{% set lang_restricted_raw = value_by_idn.get("project_business_language_restricted_list", "") | string %}
{% set lang_restricted_norm = lang_restricted_raw.replace("[", "").replace("]", "").replace('"', "").replace("'", "").lower() %}
{% set lang_restricted_tokens = [] %}
{% for lang_token in lang_restricted_norm.split(",") %}
    {{lang_restricted_tokens.append(lang_token.strip())}}
{% endfor %}
{% if lang_primary and lang_primary.lower() in lang_restricted_tokens %}
    {{det_critical_findings.append({
        "attribute_idn": "project_business_language_restricted_list",
        "severity": "CRITICAL",
        "rule": "language_conflict",
        "remediation": "settable",
        "quoted_value": lang_restricted_raw[:300],
        "explanation": "The primary language (" ~ lang_primary ~ ") also appears in the restricted-languages list, so the agent is instructed to both use and refuse its main language. Should the primary language be removed from the restricted list?",
        "det_authoritative": True
    })}}
{% endif %}

{# Merge: the deterministic floor is seeded FIRST so it wins (idn, rule) collisions for the rules it
   owns (the verdict is identical whether or not the LLM also caught it). Pass-1 then adds every
   other finding additively — including a DIFFERENT-rule finding on a floored idn, so orthogonal
   issues on one attribute stay separate. Pass-2 has a rare mark-everything mode, so its
   contribution is capped; the deterministic findings are never capped. #}
{% set pass2_findings_cap = 6 %}
{% set merged_findings = [] %}
{% set claimed_idns = {} %}
{% set claimed_idn_rules = {} %}
{% for finding in det_critical_findings %}
    {{merged_findings.append(finding)}}
    {{claimed_idns.update({finding.attribute_idn | string: True})}}
    {{claimed_idn_rules.update({(finding.attribute_idn | string) ~ "|" ~ (finding.rule | string): True})}}
{% endfor %}
{% for finding in llm_findings %}
    {% if ((finding.attribute_idn | string) ~ "|" ~ (finding.rule | string)) not in claimed_idn_rules %}
        {{merged_findings.append(finding)}}
        {{claimed_idns.update({finding.attribute_idn | string: True})}}
    {% endif %}
{% endfor %}
{% for finding in det_contract_findings + pass2_findings[:pass2_findings_cap] %}
    {% if (finding.attribute_idn | string) not in claimed_idns %}
        {{merged_findings.append(finding)}}
        {{claimed_idns.update({finding.attribute_idn | string: True})}}
    {% endif %}
{% endfor %}

{# Post-pass, every branch backed by a measured prompt failure: context suppressions where prose
   exemptions do not bind, and severity demotes for CRITICALs without a justified trigger — rule
   "none", loop rules off the target settings, residue quotes whose token exists in no gathered
   value, and missing_scenario whose routed targets all exist (inline instructions are not routes). #}
{% set transfer_enabled = GetCustomerAttribute(field="project_attributes_setting_transfer_call_enabled").strip() == "True" %}
{% set transfer_numbers = GetCustomerAttribute(field="project_attributes_setting_transfer_call_phone_numbers").strip() %}
{% set voice_only_idns = ["project_attributes_private_dynamic_voice_greeting_phrase", "project_representative_agent_voice_greeting_phrase", "project_attributes_setting_voice_integration_service_bypass_phone_number"] %}
{% set escalation_idns = ["project_business_working_hour_escalation_phone", "project_business_non_working_hour_escalation_phone"] %}
{# The two line idns stay so a genuine loop filed cross-attribute is never demoted. #}
{% set loop_target_idns = escalation_idns + ["project_attributes_setting_voice_integration_service_bypass_phone_number", "project_attributes_setting_transfer_call_phone_numbers", "project_business_public_phone", "project_representative_agent_voice_phone_number"] %}
{% set findings_kept = [] %}
{% for finding in merged_findings %}
    {% set finding_rule = finding.rule | string %}
    {% set finding_idn = finding.attribute_idn | string %}
    {% set is_voice_false_positive = (not voice_enabled) and (finding_rule in ["bypass_loop", "silent_greeting", "transfer_loop"] or finding_idn in voice_only_idns) %}
    {% set is_escalation_false_positive = finding_rule == "transfer_loop" and finding_idn in escalation_idns and (transfer_numbers or not transfer_enabled) %}
    {% set is_template_false_positive = finding_rule == "unresolved_residue" and ("_template" in finding_idn or "_send_information" in finding_idn) %}
    {% set finding_qv = finding.quoted_value | string %}
    {% set qv_tokens = re.findall('[{][{].*?[}][}]|<[|][|].*?[|][|]>', finding_qv) %}
    {% set ns_tok = namespace(grounded=False) %}
    {% for token in qv_tokens %}
        {% if token in gathered_ns.values_blob %}{% set ns_tok.grounded = True %}{% endif %}
    {% endfor %}
    {% set residue_ungrounded = finding_rule == "unresolved_residue" and not ns_tok.grounded %}
    {# 'starts the scenario' / 'says something like' are the itm compiler's own routing/inline
       markers (the qv quotes the itm value verbatim) — these patterns move with prepare_itm. #}
    {% set scenario_names = re.findall('starts the scenario[^"]*"([^"]+)"', finding_qv) %}
    {% set ns_scenario = namespace(all_exist=True) %}
    {% for scenario_name in scenario_names %}
        {% if scenario_name not in gathered_ns.ami_value %}{% set ns_scenario.all_exist = False %}{% endif %}
    {% endfor %}
    {% set scenario_ungrounded = finding_rule == "missing_scenario" and ((scenario_names and ns_scenario.all_exist) or ((not scenario_names) and "says something like" in finding_qv)) %}
    {% if not is_voice_false_positive and not is_escalation_false_positive and not is_template_false_positive %}
        {% if finding.severity == "CRITICAL" and not finding.get("det_authoritative") and (finding_rule == "none" or (finding_rule in ["transfer_loop", "bypass_loop"] and finding_idn not in loop_target_idns) or residue_ungrounded or scenario_ungrounded) %}
            {{finding.update({"severity": "WARNING"})}}
        {% endif %}
        {{findings_kept.append(finding)}}
    {% endif %}
{% endfor %}
{% set findings = [] %}
{% for sev in ["CRITICAL", "WARNING", "INFO"] %}
    {% for finding in findings_kept %}
        {% if finding.severity == sev %}
            {{findings.append(finding)}}
        {% endif %}
    {% endfor %}
{% endfor %}

{% set thoughts %}I ran a read-only audit of the whole live configuration and compiled behavior — the settable settings, the compiled values normal search hides, and the behavior layer (introduction, scenarios, procedures, and intent routing).
{% if not findings %}
No call-breaking, degrading, or suspicious configuration or behavior was detected.
{% else %}
I found {{findings | length}} item(s) to review, most important first — these are the most impactful items; a re-run may surface additional lower-priority ones. When I present these to the user I name the exact setting or behavior item, quote its current value, and frame each as a question. `remediation: settable` means I can apply a fix via `set_attribute` after the user confirms the correct value (checkpointed and one-click reversible). `remediation: canvas` means the fix is in the behavior layer — I inspect the canvas and edit the relevant item. `remediation: hand_off` means the value is compiled/derived and cannot be edited directly — I explain it and point at the source setting.

{% for finding in findings %}- **[{{finding.severity}}]** `{{finding.attribute_idn}}` — {{finding.explanation}}
  quoted value: {{finding.quoted_value if finding.quoted_value else "(empty)"}} · remediation: {{finding.remediation}}
{% endfor %}
{% endif %}{% endset %}

{{SendMessage(message='<thinking>\n' ~ thoughts ~ '\n</thinking>', actorIds=[GetActor().id | string], useFilter=False)}}
{{already_taken_actions.append(thoughts)}}

{{main(memory=memory, already_taken_actions=already_taken_actions)}}
