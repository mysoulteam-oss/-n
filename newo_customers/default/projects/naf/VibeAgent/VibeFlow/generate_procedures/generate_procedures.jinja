{% set source_item = {} %}
{% if source and source.strip() %}
    {% set source_item = json.loads(source) %}
{% endif %}
{% set mode = "update" if source_item else "create" %}
{% set tenant = GetCustomerInfo().tenant | string %}
{% set builder_branding = "NEWO AI Employee workflow builder" if not tenant or tenant == "newo" else "AI Employee workflow builder" %}

{% set canvas_raw = GetCustomerAttribute(field="project_attributes_private_dynamic_workflow_builder_canvas").strip() %}
{% set canvas = json.loads(canvas_raw) if canvas_raw else {"types": []} %}
{% set canvas_library_raw = GetCustomerAttribute(field="project_attributes_private_dynamic_workflow_builder_canvas_library").strip() %}
{% set canvas_library = json.loads(canvas_library_raw) if canvas_library_raw else [] %}

{% set procedure_reference_catalog = [] %}
{% set valid_procedure_idns = [] %}
{% for type in canvas.types %}
    {% if type.idn == "procedures" %}
        {% for item in type["items"] %}
            {% set reference_name = re.sub("^##\\s*", "", item.title | string).strip() %}
            {% if item.idn and item.idn not in valid_procedure_idns %}
                {{valid_procedure_idns.append(item.idn)}}
                {{procedure_reference_catalog.append({
                    "idn": item.idn,
                    "title": item.title,
                    "reference_name": reference_name,
                    "source": "canvas"
                })}}
            {% endif %}
        {% endfor %}
    {% endif %}
{% endfor %}
{% for type in canvas_library %}
    {% if type.idn == "procedures" %}
        {% for item in type["items"] %}
            {% set reference_name = re.sub("^##\\s*", "", item.title | string).strip() %}
            {% if item.idn and item.idn not in valid_procedure_idns %}
                {{valid_procedure_idns.append(item.idn)}}
                {{procedure_reference_catalog.append({
                    "idn": item.idn,
                    "title": item.title,
                    "reference_name": reference_name,
                    "source": "library"
                })}}
            {% endif %}
        {% endfor %}
    {% endif %}
{% endfor %}

{% set prompt %}
You are generating one `procedures` canvas item for {{builder_branding}}.

<TaskMode>{{mode}}</TaskMode>
<UserRequest>
{{query}}
</UserRequest>
{% if source_item %}
<CurrentItem role="source_of_truth_for_update">
{{json.dumps(source_item, ensure_ascii=False, indent=2)}}
</CurrentItem>
{% endif %}
<ProcedureReferenceCatalog>
{{json.dumps(procedure_reference_catalog, ensure_ascii=False, indent=2)}}
</ProcedureReferenceCatalog>

Language rules:
1. Write title, body, and description in English by default.
2. Use another language only if <UserRequest> explicitly asks for it.
3. Do not switch language only because <UserRequest> itself is written in another language.

Formatting and content requirements:
1. Output exactly one procedure item.
2. Title must use strict format: `## **<Procedure Name>** procedure`
3. Procedure body must clearly define:
   - when procedure should be invoked,
   - what conditions to check,
   - what ConvoAgent should say/do in each case.
4. Procedure must stay generic and reusable across multiple scenarios.
5. Keep behavior conversational and actionable.
6. Separate major sections or step-like blocks with one empty line, matching the GM examples. If you use `###` headings, each heading must be preceded by a blank line.
7. If the procedure references another reusable procedure, use the exact procedure display name from <ProcedureReferenceCatalog> and include that item in `mentions`.
8. Keep `mentions` empty unless the body explicitly references another reusable procedure.
9. Do not make the procedure scenario-specific unless <UserRequest> explicitly asks for that.
10. You may reference attributes using `[[attribute_idn]]`.
11. Do not output code fences, notes, or extra fields.

Update-mode rules:
- Preserve useful structure from <CurrentItem>.
- Apply only requested changes from <UserRequest>.
- Keep procedure reusable and scenario-independent unless <UserRequest> explicitly asks otherwise.

Description requirements:
- 1-2 concise sentences describing what this procedure standardizes and when to use it.
{% endset %}

{% set schema = {
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Procedure title in strict format."
    },
    "body": {
      "type": "string",
      "description": "Procedure body with invocation logic and execution instructions."
    },
    "description": {
      "type": "string",
      "description": "Short business-friendly summary."
    },
    "mentions": {
      "type": "array",
      "description": "Reusable procedure references used by the procedure body.",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": ["procedures"]
          },
          "item_idn": {
            "type": "string"
          }
        },
        "required": ["type", "item_idn"]
      }
    }
  },
  "required": ["title", "body", "description", "mentions"]
} %}

{% set generated_item = json.loads(structured_generation(prompt=prompt, schema=schema, thinking_budget=1020)) %}

{% set raw_title = re.sub("[\\u201c\\u201d]", '"', generated_item.title.strip()) %}
{% set body = re.sub("[\\u201c\\u201d]", '"', generated_item.body.strip()) %}
{% set body = re.sub("\\n{3,}", "\n\n", body).strip() %}
{% set body = re.sub("\\n*###\\s*\\*\\*", "\n\n### **", body).strip() %}
{% set description = generated_item.description.strip() %}

{% set procedure_name = re.sub("^##\\s*", "", raw_title).strip() %}
{% set procedure_name = re.sub("^\\*\\*", "", procedure_name).strip() %}
{% set procedure_name = re.sub("\\*\\*\\s*procedure\\s*$", "", procedure_name).strip() %}
{% set procedure_name = re.sub("\\*\\*$", "", procedure_name).strip() %}
{% set procedure_name = re.sub("(?i)\\s*procedure\\s*$", "", procedure_name).strip() %}
{% set procedure_name = procedure_name.strip('"').strip() %}

{% set mentions = [] %}
{% set mention_keys = [] %}
{% set candidate_mentions = generated_item.mentions if generated_item.mentions is defined else [] %}
{% for mention in candidate_mentions %}
    {% set mention_type = mention.get("type", "") %}
    {% set mention_item_idn = mention.get("item_idn", "").strip() %}
    {% set mention_key = mention_type ~ "::" ~ mention_item_idn %}
    {% if mention_type == "procedures" and mention_item_idn in valid_procedure_idns and mention_key not in mention_keys %}
        {{mention_keys.append(mention_key)}}
        {{mentions.append({
            "type": "procedures",
            "item_idn": mention_item_idn
        })}}
    {% endif %}
{% endfor %}

{% set title = "## **" ~ procedure_name ~ "** procedure" %}
{% set item = {
    "title": title.strip(),
    "body": body.strip(),
    "description": description.strip(),
    "mentions": mentions
} %}

{{Return(val=json.dumps(item, ensure_ascii=False, indent=2))}}
