{% set candidate_attribute_idns = base_attribute_idns + branding_sensitive_attributes + industry_attributes %}
{% set searchable_attributes = [] %}
{% set searchable_attribute_idns = [] %}
{% set attributes_by_idn = {} %}
{% for attribute_idn in candidate_attribute_idns %}
    {% if attribute_idn not in attributes_by_idn %}
        {% set attribute_metadata = GetCustomerMetadataAttribute(idn=attribute_idn) %}
        {% if attribute_metadata %}
            {% set attribute_metadata = attribute_metadata.model_dump() %}
            {% set attribute_value = ((attribute_metadata.value if attribute_metadata.value is not none else "") | string).strip() %}
            {% if attribute_value | length > 500 %}
                {% set attribute_value = attribute_value[:500] ~ "..." %}
            {% endif %}
            {% set attribute = {
                "idn": attribute_idn,
                "value": attribute_value,
                "title": attribute_metadata.title,
                "description": attribute_metadata.description,
                "group": attribute_metadata.group,
                "is_hidden": attribute_metadata.isHidden,
                "possible_values": attribute_metadata.possibleValues,
                "value_type": attribute_metadata.valueType
            } %}
        {% else %}
            {% set attribute_value = GetCustomerAttribute(field=attribute_idn).strip() %}
            {% if attribute_value | length > 500 %}
                {% set attribute_value = attribute_value[:500] ~ "..." %}
            {% endif %}
            {% set attribute = {
                "idn": attribute_idn,
                "value": attribute_value
            } %}
        {% endif %}

        {% set branding_check_text = json.dumps(attribute, indent=2, ensure_ascii=False).lower() %}
        {% if is_newo_tenant or "newo" not in branding_check_text %}
            {{searchable_attributes.append(attribute)}}
            {{searchable_attribute_idns.append(attribute_idn)}}
            {{attributes_by_idn.update({attribute_idn: attribute})}}
        {% endif %}
    {% endif %}
{% endfor %}

{% set prompt %}You are the `search_attribute` action for Vibe Builder{% if is_newo_tenant %} at Newo{% endif %}. Vibe Builder passes you a semantic description of what it needs to understand or change in the AI Employee configuration.

Your job:
- Read <SearchIntent> as the user's configuration intent, not as a bag of keywords.
- Inspect every object in <SearchableAttributes>. Each object contains the searchable attribute idn, current value, title, description, group, visibility, possible values, and value type when available.
- Return the customer attribute idns that are most relevant to the intent.
- If the intent exactly names an attribute idn, include it.
- Prefer a small, useful set. Return multiple attributes only when they are genuinely related or ambiguity is useful for the caller.
- Do not return the whole catalog.

<SearchIntent>
{{query}}
</SearchIntent>{% if industry_label %}

<Industry>
The customer operates in the {{industry_label}} industry. When the query relates to a workflow specific to this industry (booking, scheduling, services, products, pricing, etc.), prefer industry-specific attributes over generic settings whenever both could plausibly match.
</Industry>{% endif %}

<SearchableAttributes>
{{json.dumps(searchable_attributes, ensure_ascii=False, indent=2)}}
</SearchableAttributes>{% endset %}

{% set schema = {
  "type": "object",
  "properties": {
    "related_attributes": {
        "type": "array",
        "items": {
            "type": "string",
            "description": "One of the customer attribute idns listed in SearchableAttributes",
            "enum": searchable_attribute_idns
        },
        "description": "Customer attributes to return to the main VibeAgent loop"
    }
  },
  "required": ["related_attributes"]
}
%}

{% set result = json.loads(structured_generation(schema=schema, prompt=prompt)) %}
{% set resolved_related_attributes = [] %}
{% for attr in result.related_attributes %}
    {% set attribute = attributes_by_idn.get(attr) %}
    {% if attribute %}
        {{resolved_related_attributes.append(attribute)}}
    {% endif %}
{% endfor %}
{% set thoughts = '' %}
{% if not resolved_related_attributes %}
    {% set thoughts = 'I did not find any attributes for the query: `' ~ query ~ '`' %}
{% else %}
    {% set thoughts = "I have found the following attributes:\n\n" %}
{% endif %}
{% for attribute in resolved_related_attributes %}
    {% set attribute_value = attribute.value %}
    {% if not attribute_value %}
        {% set attribute_value = '[No value]' %}
    {% endif %}
    {% set thoughts = thoughts ~ '**IDN:** `' ~ attribute.idn ~ '`\n**Current value:** ' ~ attribute_value ~ '\n' %}

    {% if attribute.title and attribute.title.strip() %}
        {% set thoughts = thoughts ~ '**Title:** ' ~ attribute.title.strip() ~ '\n' %}
    {% endif %}

    {% if attribute.description and attribute.description.strip() %}
        {% set thoughts = thoughts ~ '**Description:** ' ~ attribute.description.strip() ~ '\n' %}
    {% endif %}

    {% if attribute.group and attribute.group.strip() %}
        {% set thoughts = thoughts ~ '**Group:** ' ~ attribute.group.strip() ~ '\n' %}
    {% endif %}

    {% if attribute.is_hidden is not none %}
        {% set thoughts = thoughts ~ '**Is Hidden:** ' ~ attribute.is_hidden | string ~ '\n' %}
    {% endif %}

    {% if attribute.possible_values %}
        {% set thoughts = thoughts ~ '**Possible Values:** ' ~ attribute.possible_values ~ '\n' %}
    {% endif %}

    {% if attribute.value_type and attribute.value_type.strip() %}
        {% set thoughts = thoughts ~ '**Value Type:** ' ~ attribute.value_type.strip() ~ '\n' %}
    {% endif %}

{% endfor %}

{{SendMessage(message='<thinking>\n' ~ thoughts ~ '\n</thinking>', actorIds=[GetActor().id| string], useFilter=False)}}
{{already_taken_actions.append(thoughts)}}

{{main(memory=memory, already_taken_actions=already_taken_actions)}}
