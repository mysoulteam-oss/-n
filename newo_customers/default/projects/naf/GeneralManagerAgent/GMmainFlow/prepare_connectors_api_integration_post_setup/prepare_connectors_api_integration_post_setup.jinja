{# Outgoing Webhooks not needed before Agent Creator callback #}

{% set sa_send_hitl_report = GetWebhook(webhookIdn = "sa_send_hitl_report", webhookType = "outgoing") %}
{% if not sa_send_hitl_report %}
    {# TODO: Remove hardcoded URL #}
    {{CreateWebhook(
        idn = "sa_send_hitl_report",
        connectorIdn = "webhook",
        webhookType = "outgoing",
        description = "SuperAgent - Send HITL Report WebHook",
        url = "https://script.google.com/macros/s/AKfycbyFJyTkKW5wqh0QK4wHyOxFhf7AB4-X0oTGubeBPuPTXKoL27IT7fx7fy1y2yGByVknow/exec",
        commandIdns = ["send_hitl_report"]
    )}}
