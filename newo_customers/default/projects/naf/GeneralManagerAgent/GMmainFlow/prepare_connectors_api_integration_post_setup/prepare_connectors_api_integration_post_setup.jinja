    {{CreateWebhook(
        idn = "web_search",
        connectorIdn = "webhook",
        webhookType = "incoming",
        description = "SuperAgent - Web Search WebHook",
        allowedIps = [],
        eventIdns = ["web_search_event"]
    )}}
{% endif %}
