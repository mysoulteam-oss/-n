  default="*(No additional questions were provided.)*"
)}}

{{set_customer_attribute_from_ac_if_first_init_and_empty(is_first_init_done=is_first_init_done, naf_field="project_attributes_hospitality_regular_reservation_check_in_notes", ac_field="agent_creator_hospitality_regular_reservation_check_in_notes")}}

{{set_customer_attribute_from_ac_if_first_init_and_empty(is_first_init_done=is_first_init_done, naf_field="project_attributes_hospitality_regular_reservation_questions", ac_field="agent_creator_hospitality_regular_reservation_questions")}}

