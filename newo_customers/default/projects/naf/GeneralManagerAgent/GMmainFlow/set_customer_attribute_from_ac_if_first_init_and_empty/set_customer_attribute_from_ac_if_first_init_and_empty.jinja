{# Check if NAF value is NOT empty #}
{% set naf_value = GetCustomerAttribute(field=naf_field) %}
{% if naf_value and naf_value.strip() %}
    {{Return(val="")}}
{% endif %}

{# Resolve default values that reference another Customer Attribute, e.g. [[project_business_manager_email]] #}
{% set default_value = default %}
{% set default_str = default | string %}
{% if default_str.startswith("[[") and default_str.endswith("]]") %}
    {% set default_ref_field = default_str[2:-2].strip() %}
    {% if default_ref_field %}
        {% set default_value = GetCustomerAttribute(field=default_ref_field) %}
    {% endif %}
{% endif %}

{# Reset it anyway as it might be fully absent #}
{# _utilsCustomerAttributeSetIfEmptySkill, in fact #}
{# previous ac attr was empty and empty was always created #}
{# Check if it is NOT a first init, otherwise _utilsCustomerAttributeSetIfEmptySkill and exit #}
{% if is_first_init_done | string == "True" %}
    {{SetCustomerAttribute(field=naf_field, value=default_value)}}
    {{Return(val="")}}
{% endif %}

{# Check for no option #}
{% set ac_value = GetCustomerAttribute(field=ac_field) %}
{% if not ac_value or not ac_value.strip() or ac_value == "N/A" %}
    {% set ac_value = default_value %}
{% endif %}

{{SetCustomerAttribute(field=naf_field, value=ac_value)}}
