{# Migrate `*_phone_number_without_country_code` → bare `*_phone_number`
   in the customer's workflow-builder canvas. Idempotent (replace no-op).
   Repo-side templates and rebuilt persona attributes are out of scope. #}
{% set current_canvas = GetCustomerAttribute(field="project_attributes_private_dynamic_workflow_builder_canvas").strip() %}

{% if not current_canvas %}
    {{Return()}}
{% endif %}

{% set updated_canvas = current_canvas.replace("user.provided_phone_number_without_country_code", "user.provided_phone_number").replace("user.detected_phone_number_without_country_code", "user.detected_phone_number") %}

{{ SetCustomerAttribute(
    field="project_attributes_private_dynamic_workflow_builder_canvas",
    value=updated_canvas
) }}
