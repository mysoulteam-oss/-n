{% set request_args = GetTriggeredAct().arguments %}

{% set event_type = request_args.get("event_type", "") %}
{% set request_index = request_args.get("request_index", "0") | int %}
{% set result_index = request_args.get("result_index", "0") | int %}
{% set chunk_index = request_args.get("chunk_index", "0") | int %}

{% if request_index < 0 or result_index < 0 or chunk_index < 0 %}
    {% set error_message = request_args.get("topic", "Website RAG append failed.") %}
    {% set retry_request = request_args.get("retry_request", "") %}
    {% if not retry_request.strip() %}
        {% set retry_request = GetCustomerAttribute(field="project_attributes_rag_knowledge_base_append_websites") %}
        {% set request_label = "Original request" %}
    {% else %}
        {% set request_label = "Retry request" %}
    {% endif %}

    {% set failed_log_entry %}
Status: Failed
Error: {{ error_message }}

{{ request_label }}:
{{ retry_request }}
    {% endset %}

    {{rag_append_extend_log(
        input_unstructured_text=failed_log_entry,
        output_log_attribute_name="project_attributes_rag_knowledge_base_append_websites_log"
    )}}
    {{SetCustomerAttribute(field="project_attributes_rag_knowledge_base_append_websites", value="")}}
    {{Return()}}
{% endif %}

{% if event_type == "finalize" %}
    {% set extended_websites_text = GetCustomerAttribute(field="project_attributes_private_dynamic_rag_knowledge_base_append_websites_text") %}
{% else %}
    {# Accumulate scraped text from chunks #}
    {% set websites_text = GetCustomerAttribute(field="project_attributes_private_dynamic_rag_knowledge_base_append_websites_text") %}
    {% set extended_websites_text = websites_text ~ request_args.topic %}
    {{SetCustomerAttribute(field="project_attributes_private_dynamic_rag_knowledge_base_append_websites_text", value=extended_websites_text)}}

    {# New scraper responses finalize with an explicit event. Keep 0/0/0 only as a legacy fallback. #}
    {% if event_type == "chunk" %}
        {{Return()}}
    {% endif %}
    {% if result_index != 0 or chunk_index != 0 or request_index != 0 %}
        {{Return()}}
    {% endif %}
{% endif %}

{% if not extended_websites_text.strip() %}
    {{SetCustomerAttribute(field="project_attributes_rag_knowledge_base_append_websites", value="")}}
    {{Return()}}
{% endif %}

{# Log the User Input (URLs/Instructions) for historical reference #}
{% set source_request = GetCustomerAttribute(field="project_attributes_rag_knowledge_base_append_websites") %}
{% if not source_request.strip() %}
    {% set source_request = GetState(name="previous_rag_knowledge_base_append_websites") %}
{% endif %}
{% if source_request.strip() %}
    {{rag_append_extend_log(
        input_unstructured_text=source_request,
        output_log_attribute_name="project_attributes_rag_knowledge_base_append_websites_log"
    )}}
{% endif %}
{{SetCustomerAttribute(field="project_attributes_rag_knowledge_base_append_websites", value="")}}

{# Process the accumulated scraped text #}
{{rag_append_convert_to_structured_text(
    input_unstructured_text=extended_websites_text,
    output_structured_attribute_name="project_attributes_private_dynamic_rag_knowledge_base_append_websites_text_structured",
)}}
{{SetCustomerAttribute(field="project_attributes_private_dynamic_rag_knowledge_base_append_websites_text", value="")}}

{% set websites_text_structured = GetCustomerAttribute(field="project_attributes_private_dynamic_rag_knowledge_base_append_websites_text_structured") %}
{{rag_append_create_akb_topics(
    label="rag_autogenerated_from_websites",
    id_prefix="afw_",
    input_structured_text=websites_text_structured
)}}
{{SetCustomerAttribute(field="project_attributes_private_dynamic_rag_knowledge_base_append_websites_text_structured", value="")}}
