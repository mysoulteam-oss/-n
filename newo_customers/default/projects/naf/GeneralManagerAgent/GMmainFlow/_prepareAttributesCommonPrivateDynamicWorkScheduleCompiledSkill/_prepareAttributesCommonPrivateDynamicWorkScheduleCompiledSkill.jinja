{# _prepareAttributesCommonPrivateDynamicWorkScheduleCompiledSkill.nsl
   Runner: nsl (Jinja2). Registered in GMmainFlow.yaml with runner_type: nsl.
   Called synchronously from _postSetupAccountSkill.nslg:88 after legacy object producer.
   Optional testWorkSchedule param bypasses cache and state writes for test harness.
#}

{# Current date for year-less exception resolution. Resolved against UTC —
   ±1 day edge tolerated for TZ offsets ≥|12h|. Schedule itself is TZ-agnostic.
   Hoisted to top so cache key (year suffix) and prompt (CurrentDate block) share one call. #}
{% set current_date = GetDateTime(format="date", timezone="Etc/UTC") %}
{% set current_year = current_date.split("-")[0] %}

{% set test_input = testWorkSchedule.strip() %}

{% if test_input %}
    {% set working_hours_raw = test_input %}
{% else %}
    {% set working_hours_raw = GetCustomerAttribute(field="project_business_working_hours").strip() %}

    {# Cache-key composite "<raw>|<year>" — LLM resolves year-less exception dates
       (e.g. "December 25") against current UTC date; cache must invalidate on
       year-rollover or partner-declared exceptions silently expire. Timezone is not
       part of the schema — schedule HH:MM is partner-local and TZ-agnostic; consumers
       apply project_business_time_zone at evaluation time. #}
    {% set cache_key = working_hours_raw ~ "|" ~ current_year %}
    {% set previous_input = GetState(name="whe_producer_last_input").strip() %}

    {% if cache_key == previous_input %}
        {% set existing = GetCustomerAttribute(field="project_attributes_private_dynamic_schedule_compiled").strip() %}
        {% if existing %}
            {{ Return() }}
        {% endif %}
    {% endif %}

    {% if not working_hours_raw %}
        {{ SetCustomerAttribute(field="project_attributes_private_dynamic_schedule_compiled", value=" ") }}
        {{ SetState(name="whe_producer_last_input", value=cache_key) }}
        {{ Return() }}
    {% endif %}
{% endif %}

