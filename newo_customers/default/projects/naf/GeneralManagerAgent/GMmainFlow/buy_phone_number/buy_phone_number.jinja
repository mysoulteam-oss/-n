{# JSON object - example: `{'area_code': '650', 'country_code': 'US', 'fallback_area_code': '408'}` or `{'country_code': 'NL'}` #}
{# TODO: Remove temporal fix with replacing single quotes to double #}
{% set agent_creator_voice_channel_phone = GetCustomerAttribute(field="agent_creator_voice_channel_phone") %}
{% set agent_creator_voice_channel_phone = agent_creator_voice_channel_phone.replace("'", '"') %}
{% if agent_creator_voice_channel_phone.strip() and agent_creator_voice_channel_phone != "{}" %}
    {% set agent_creator_voice_channel_phone = json.loads(agent_creator_voice_channel_phone) %}
    {# `agent_creator_voice_channel_phone.country_code` must not be empty, `project_representative_agent_voice_phone_alpha2_code` is used as a fallback for existing old accounts #}
    {% set country_code = agent_creator_voice_channel_phone.get("country_code", "") %}
    {# `agent_creator_voice_channel_phone.area_code` is optional, `project_representative_agent_voice_phone_area_code` is used as a fallback for existing old accounts #}
    {% set area_code = agent_creator_voice_channel_phone.get("area_code", "") %}
    {# `agent_creator_voice_channel_phone.fallback_area_code` is optional, `project_representative_agent_voice_phone_fallback_area_code` is used as a fallback for existing old accounts #}
    {% set fallback_area_code = agent_creator_voice_channel_phone.get("fallback_area_code", "") %}
{% else %}
    {% set country_code = GetCustomerAttribute(field="project_representative_agent_voice_phone_alpha2_code") %}
    {% set area_code = GetCustomerAttribute(field="project_representative_agent_voice_phone_area_code") %}
    {% set fallback_area_code = GetCustomerAttribute(field="project_representative_agent_voice_phone_fallback_area_code") %}
{% endif %}

{% if GetCustomerAttribute(field="project_attributes_private_account_initialized_first_time") == "True" %}
    {{DUMMY("Skipping phone purchase: account already initialized")}}
    {{Return()}}
{% endif %}

{% if not country_code.strip() %}
    {{DUMMY("Skipping phone purchase: missing country_code (" ~ country_code ~ ")")}}
    {{Return()}}
{% endif %}

{% set newo_voice_connector = GetConnectorInfo(integrationIdn="newo_voice", connectorIdn="newo_voice_connector") %}
{% if not newo_voice_connector %}
    {{DUMMY("Skipping phone purchase: missing `newo_voice_connector` connector info")}}
    {{Return()}}
{% endif %}

{% set existing_agent_phone_number = "" %}
{% if newo_voice_connector.settings and newo_voice_connector.settings.ai_phone_number %}
    {% set existing_agent_phone_number = (newo_voice_connector.settings.ai_phone_number | string).strip() %}
{% endif %}
{% if existing_agent_phone_number %}
    {{DUMMY("Skipping phone purchase: `newo_voice_connector` already has a phone number")}}
    {{SetCustomerAttribute(field="project_representative_agent_voice_phone_number", value=existing_agent_phone_number)}}
    {{Return()}}
{% endif %}

{% set buy_phone_kwargs = {"countryCode": country_code, "isVoice": True, "isSms": True} %}
{% if area_code %}
    {{buy_phone_kwargs.update({"areaCode": area_code})}}
{% endif %}
{% if fallback_area_code %}
    {{buy_phone_kwargs.update({"fallbackAreaCode": fallback_area_code})}}
{% endif %}

{% set supported_phone_providers_raw = GetCustomerAttribute(field="agent_creator_supported_phone_providers").strip() %}
{% set supported_phone_providers = [] %}
{% if supported_phone_providers_raw.startswith("[") and supported_phone_providers_raw.endswith("]") %}
    {% set supported_phone_providers = json.loads(supported_phone_providers_raw) %}
{% endif %}
{% if supported_phone_providers|length > 0 %}
    {{buy_phone_kwargs.update({"providers": supported_phone_providers})}}
{% endif %}

{% set supported_phone_group = GetCustomerAttribute(field="agent_creator_supported_phone_group").strip() %}
{% if supported_phone_group %}
    {{buy_phone_kwargs.update({"group": supported_phone_group})}}
{% endif %}

{% set phone = BuyPhoneNumber(**buy_phone_kwargs) %}
{% if not phone or not phone.id or not phone.number %}
    {{DUMMY("Skipping phone linking: BuyPhoneNumber returned incomplete payload")}}
    {{Return()}}
{% endif %}

{# TODO: Sync phone-region Attributes when BuyPhoneNumber returns structured country/area metadata. Do not parse `phone.number` for this. #}

{{SetCustomerAttribute(field="project_representative_agent_voice_phone_number", value=phone.number)}}

{{LinkPhoneNumber(
    phoneNumberId=phone.id,
    connectorIdn="newo_voice_connector",
    integrationIdn="newo_voice"
)}}

{% set phone_provider = phone.provider | string | lower %}
{% if phone_provider == "twilio" %}
    {% set sms_integration_idn = "twilio_messenger" %}
    {% set sms_connector_idn = "sms_connector" %}
    {{SetCustomerAttribute(field="project_attributes_setting_sms_provider", value="twilio_messenger")}}
{% else %}
    {% set sms_integration_idn = "newo_sms" %}
    {% set sms_connector_idn = "newo_sms_connector" %}
    {{SetCustomerAttribute(field="project_attributes_setting_sms_provider", value="sms_service")}}
{% endif %}

{% set sms_connector = GetConnectorInfo(integrationIdn=sms_integration_idn, connectorIdn=sms_connector_idn) %}
{% if not sms_connector %}
    {{DUMMY("Skipping SMS phone linking: missing `" ~ sms_connector_idn ~ "` connector info")}}
    {{Return()}}
{% endif %}

{{LinkPhoneNumber(
    phoneNumberId=phone.id,
    connectorIdn=sms_connector_idn,
    integrationIdn=sms_integration_idn
)}}

{{AddPhoneNumberToPool(phone_number=phone.number)}}
