{# outbound writes a signature-less phrase here — pass through raw #}
{% if GetPersonaAttribute(id=user_id, field="outbound_session").strip() == "True" %}
    {{ Return(val=GetPersonaAttribute(id=user_id, field="greeting_phrase")) }}
{% endif %}

{% set greeting_phrase = GetPersonaAttribute(id=user_id, field="greeting_phrase").strip() %}
{% if not greeting_phrase %}
    {{ Return(val="") }}
{% endif %}

{% set current_signature = session_get_greeting_source_signature() %}
{% set stored_signature = GetPersonaAttribute(id=user_id, field="persona_greeting_signature").strip() %}
{% if current_signature.strip() != stored_signature %}
    {{ Return(val="") }}
{% endif %}

{{ Return(val=greeting_phrase) }}
