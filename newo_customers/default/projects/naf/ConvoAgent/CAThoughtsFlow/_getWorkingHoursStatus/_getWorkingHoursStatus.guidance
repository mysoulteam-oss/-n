{{!-- Returns cached working_hours_status BOOL ("true"/"false"); returns "true" when
     both feature flags are off so truthiness-gated callers stay non-blocking.
     Cache is warmed by session_get_working_hours_status.nslg during prompt build;
     callers must tolerate empty result on rare pre-warm edge cases. --}}

{{!-- Gate by (WHE OR LEGACY) == "True". NSLG has no boolean OR helper, so this
     nests as two #if blocks with inverted polarity. --}}
{{Set(name="wheFlag", value=GetCustomerAttribute(field="project_attributes_setting_working_hours_structured_format_enabled"))}}
{{Set(name="wheFlag", value=wheFlag.strip())}}
{{Set(name="legacyFlag", value=GetCustomerAttribute(field="project_attributes_setting_define_conversation_is_during_working_hours_enabled"))}}
{{Set(name="legacyFlag", value=legacyFlag.strip())}}
{{#if wheFlag != "True"}}
    {{#if legacyFlag != "True"}}
        {{Return(val="true")}}
    {{/if}}
{{/if}}

{{Set(name="working_hours_status", value=GetPersonaAttribute(id=userId, field="working_hours_status"))}}
{{Set(name="working_hours_status", value=working_hours_status.strip())}}
{{Return(val=working_hours_status)}}
