{% set response = Gen(jsonSchema=schema, validateSchema=True, temperature=0.2, topP=0, skipFilter=True, thinkingBudget=425) %}
{% set response = json.loads(response) %}

{% set user_name = response.user_name %}
{% set user_email = response.user_email %}
{% set user_language = response.user_preferred_language %}
{% set user_phone_number_with_country_code = response.user_phone_number_with_country_code %}
{% set user_phone_number_country_code = response.user_phone_number_country_code %}
{% set user_phone_number_without_country_code = response.user_phone_number_without_country_code %}
{% set sms_subscribed = response.sms_opt_in %}
{% set email_subscribed = response.email_opt_in %}

{# TODO: Define setting Persona Name - check `_extractValuesFromConversationSkill` and `EndSessionSkill` #}
{% if user_name.strip() %}
    {% if not IsSimilar(val1=user_name, val2="null", threshold=0.8, strategy="symbols") %}
        {{ SetPersonaAttribute(id=userId, field="full_name", value=user_name) }}
        {{ UpdateUser(field="name", value=user_name) }}
    {% endif %}
{% endif %}

{% if user_email.strip() %}
    {% if not IsSimilar(val1=user_email, val2="null", threshold=0.8, strategy="symbols") %}
        {{ SetPersonaAttribute(id=userId, field="email", value=user_email) }}
    {% endif %}
{% endif %}

{#  never equals to null bcz of primary_language  #}
{{ SetPersonaAttribute(id=userId, field="user_language", value=user_language) }}

{% if user_phone_number_with_country_code.strip() != "null" %}
    {{ SetPersonaAttribute(id=userId, field="provided_phone_number_with_country_code", value=user_phone_number_with_country_code) }}
{% endif %}

{% if user_phone_number_country_code.strip() != "null" %}
    {{ SetPersonaAttribute(id=userId, field="provided_phone_number_country_code", value=user_phone_number_country_code) }}
{% endif %}

{% if user_phone_number_without_country_code.strip() != "null" %}
    {{ SetPersonaAttribute(id=userId, field="provided_phone_number_without_country_code", value=user_phone_number_without_country_code) }}

    {% set agent_country_code = GetCustomerAttribute(field="project_representative_agent_voice_phone_country_code").strip() %}

    {% if user_phone_number_country_code == "null" %}
        {#
            UNRECOGNIZED COUNTRY CODE:
            The matching logic above could not identify a known country code in the user's
            phone number. Fall back to spelling the full normalized number as-is.
        #}
        {% set phone_number_normalized = user_phone_number_without_country_code %}
    {% elif user_phone_number_country_code == agent_country_code %}
        {#
            LOCAL CALL:
            The user dials from the same country as the agent.
            Prepend the national trunk code so the agent pronounces the number the way
            a local would dial it (e.g., for Ukraine +380: "0 XX XXX XX XX").
            If the country has no trunk code (e.g., USA), the prefix is empty.
        #}
        {% set trunk_code = json.loads(_country_codes_to_trunk_code_map()).get(user_phone_number_country_code, "") %}
        {% set phone_number_normalized = trunk_code ~ user_phone_number_without_country_code %}
    {% else %}
        {#
            FOREIGN CALL:
            The user dials from a different country than the agent.
            Use the full international number (country code + national number) without "+".
        #}
        {% set phone_number_normalized = user_phone_number_country_code ~ user_phone_number_without_country_code %}
    {% endif %}

    {{SetPersonaAttribute(id=userId, field="provided_phone_number", value=phone_number_normalized)}}
{% endif %}

{{SetPersonaAttribute(id=userId, field="sms_subscribed", value=(sms_subscribed | string).lower())}}

{{SetPersonaAttribute(id=userId, field="email_subscribed", value=(email_subscribed | string).lower())}}

