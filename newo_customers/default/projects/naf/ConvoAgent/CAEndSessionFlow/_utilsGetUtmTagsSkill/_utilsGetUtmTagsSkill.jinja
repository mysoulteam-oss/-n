{# Handle None from GetPersonaAttribute #}
{% if urlParams is none or not urlParams %}
    {{Return(val="")}}
{% endif %}

{# Validate format before parsing (prevents crash) #}
{% set urlParams_str = urlParams|string|trim %}
{% if not urlParams_str or not (urlParams_str.startswith('[') and urlParams_str.endswith(']')) %}
    {{Return(val="")}}
{% endif %}

{# Parse JSON #}
{% set parsed_params = json.loads(urlParams_str) %}

{# Build UTM lines with safe key access #}
{% set utm_lines = [] %}
{% for param in parsed_params %}
    {% if 'name' in param and 'value' in param %}
        {% if param.name and param.name.startswith("utm_") %}
            {{utm_lines.append(param.name ~ ": " ~ param.value)}}
        {% endif %}
    {% endif %}
{% endfor %}

{{Return(val=utm_lines|join("\n")) if utm_lines else ""}}
