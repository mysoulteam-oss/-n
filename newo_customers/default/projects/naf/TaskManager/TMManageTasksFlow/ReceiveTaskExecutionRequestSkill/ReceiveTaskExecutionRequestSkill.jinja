{% set arguments = GetTriggeredAct().arguments %}

{% if not arguments.taskType or not arguments.task %}
    {{Return()}}
{% endif %}

{% set task_type = arguments.taskType %}
{% set task = arguments.task %}

{% set execution_time = _enforceOutboundTaskWorkingHoursSkill(
    taskType=task_type,
    executionTime=_defineExecutionTimeSkill()
) %}

{% if execution_time == "asap" %}
    {{_sendTaskSkill(task=task, taskType=task_type)}}
    {{Return()}}
{% endif %}

{% set task_meta = json.loads(task) %}
{% set schedule_comment = "Task is rescheduled to the next working-hours slot. Execution time : " ~ _utilsFromUtcToLocalDateTimeSkill(datetimeUtc=execution_time) %}
{% set existing_tasks = SearchFuzzyAkb(query=task_meta.id, searchFields=["name"], fromPerson="Agent", numberTopics=1) %}

{% if not existing_tasks %}
    {% set task_summary = task_meta.arguments.content if task_meta.arguments and task_meta.arguments.content else task %}
    {{SetManualAkb(personaId=GetAgentPersona().id | string, summary=task_summary, facts=[schedule_comment ~ "\n---"], name=task_meta.id, source=task, labels=["sent to worker"])}}
{% else %}
    {{_updateTaskStatusSkill(taskId=task_meta.id, status="sent to worker", comment=schedule_comment)}}
{% endif %}

{{SendCommand(
    commandIdn="set_timer",
    integrationIdn="program_timer",
    connectorIdn="session_timer",
    fireAt=execution_time,
    timerName="task_manager_scheduled_task_" ~ task_meta.id,
    eventIdn="task_manager_trigger_task",
    personaId=task_meta.user_id
)}}
