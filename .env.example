# Copy this file to .env and fill in your real values.
# The .env file is git-ignored so nothing sensitive lands in source control.

# --- Nevo AI ---
NEVO_API_KEY=your-nevo-api-key-here

# --- SIP account (Zadarma) ---
SIP_DOMAIN=sip.zadarma.com
SIP_USERNAME=your-sip-login
SIP_PASSWORD=your-sip-password
SIP_NUMBER=+00000000000
# Optional:
SIP_EXPIRES=300
SIP_PORT=5060
