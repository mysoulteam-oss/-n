# Скопируй этот файл в .env и подставь свои значения:
#   cp .env.example .env
#
# ВАЖНО: .env добавлен в .gitignore и НЕ попадёт в репозиторий.

# API-ключ сервиса
API_KEY=your_api_key_here

# Базовый URL API (endpoint сервиса «Нево аи»).
# Уточни в документации сервиса и подставь сюда.
API_BASE_URL=https://api.example.com/v1

# Модель по умолчанию (если сервис поддерживает выбор модели)
MODEL=default
