# Copy to `.env` and fill in your key. `.env` is git-ignored — never commit it.

# Required: your key from the Newo platform (Account → API Keys).
NEWO_API_KEY=your-newo-api-key-here

# Optional: override the API host (defaults to https://app.newo.ai).
# NEWO_BASE_URL=https://app.newo.ai

# Optional: request timeout in seconds (defaults to 30).
# NEWO_TIMEOUT=30
