# Скопируй этот файл в .env и подставь свои значения:
#   cp .env.example .env
#
# ВАЖНО: .env добавлен в .gitignore и НЕ попадёт в репозиторий.

# API-ключ Newo (личный кабинет: Account -> API Keys)
NEWO_API_KEY=your_newo_api_key_here

# Базовый URL API. Рабочий хост — app.newo.ai (в доках указан api.newo.ai).
NEWO_BASE_URL=https://app.newo.ai/api/v1

# UUID актёра-пользователя (user_actor_id) для чата.
# Нужен только для отправки/чтения сообщений; для проверки авторизации не требуется.
NEWO_USER_ACTOR_ID=

# --- SIP-транк (интеграция newo_voice) ---
# provider: twilio | sip | custom_sip | csc-telecom | telnyx | webrtc
NEWO_SIP_PROVIDER=sip
NEWO_SIP_HOSTNAME=sip.example.com
NEWO_SIP_USERNAME=your_sip_login
NEWO_SIP_PASSWORD=your_sip_password
NEWO_SIP_CALLER_ID=+10000000000
NEWO_SIP_CONNECTOR_IDN=newo_voice_connector
